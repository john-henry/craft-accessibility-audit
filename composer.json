{
  "name": "johnhenry/craft-accessibility-audit",
  "description": "WCAG 2.2 accessibility audits for Craft CMS 5: scan every page, fix what fails, and keep the record, statement and VPAT to show for it.",
  "type": "craft-plugin",
  "version": "1.5.0",
  "keywords": [
    "accessibility",
    "accessibility checker",
    "wcag",
    "wcag 2.2",
    "a11y",
    "axe-core",
    "european accessibility act",
    "en 301 549",
    "vpat",
    "accessibility statement",
    "alt text",
    "contrast"
  ],
  "license": "proprietary",
  "authors": [
    {
      "name": "John Henry",
      "homepage": "https://johnhenry.ie"
    }
  ],
  "homepage": "https://johnhenry.ie/plugins/accessibility-audit",
  "require": {
    "chrome-php/chrome": "^1.16",
    "craftcms/cms": "^5.0",
    "johnhenry/craft-ip-guard": "^1.3",
    "php": "^8.2 || ^8.3 || ^8.4"
  },
  "require-dev": {
    "craftcms/commerce": "^5.0",
    "craftcms/ecs": "dev-main",
    "craftcms/phpstan": "dev-main",
    "phpstan/phpstan": "^2.2"
  },
  "suggest": {
    "putyourlightson/craft-blitz": "Keeps the admin-only accessibility overlay out of Blitz's page cache."
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "autoload": {
    "psr-4": {
      "johnhenry\\accessibilityaudit\\": "src/"
    }
  },
  "scripts": {
    "phpstan": "phpstan --ansi --memory-limit=1G",
    "check-cs": "ecs check --ansi",
    "fix-cs": "ecs check --fix --ansi"
  },
  "config": {
    "allow-plugins": {
      "craftcms/plugin-installer": true,
      "pestphp/pest-plugin": true,
      "yiisoft/yii2-composer": true
    },
    "optimize-autoloader": true,
    "sort-packages": true
  },
  "support": {
    "docs": "https://johnhenry.ie/plugins/accessibility-audit/docs",
    "source": "https://github.com/john-henry/craft-accessibility-audit",
    "issues": "https://github.com/john-henry/craft-accessibility-audit/issues"
  },
  "extra": {
    "name": "Accessibility Audit",
    "handle": "accessibility-audit",
    "developer": "John Henry",
    "developerUrl": "https://johnhenry.ie",
    "documentationUrl": "https://johnhenry.ie/plugins/accessibility-audit/docs/",
    "changelogUrl": "https://github.com/john-henry/craft-accessibility-audit/blob/craft-5/CHANGELOG.md",
    "class": "johnhenry\\accessibilityaudit\\AccessibilityAudit"
  }
}
