{% extends '_layouts/cp' %}

{% set title = 'Asset Accessibility'|t('accessibility-audit') %}
{% set selectedSubnavItem = 'assets' %}
{% set isPlus = isPlus ?? false %}
{% set pdfEnabled = pdfEnabled ?? false %}
{% set pdfView = pdfView ?? false %}
{% set pdfStats = pdfStats ?? null %}
{% set pdfStatus = pdfStatus ?? 'issues' %}
{% set draftsView = activeFilter == 'drafts' %}
{% set draftCount = draftCount ?? 0 %}
{% set failedDraftCount = failedDraftCount ?? 0 %}
{% set pendingDraftCount = pendingDraftCount ?? 0 %}
{% set draftingRunning = draftingRunning ?? false %}
{% set crumbs = [
    { label: 'Accessibility Audit'|t('accessibility-audit'), url: cpUrl('accessibility-audit') },
    { label: title },
] %}

{% set issueGroups = {
    'asset-alt-missing':  { label: 'Missing alt'|t('accessibility-audit'),        severity: 'warning', rows: [] },
    'asset-alt-filename': { label: 'Filename as alt'|t('accessibility-audit'),     severity: 'warning', rows: [] },
    'asset-alt-short':    { label: 'Very short alt'|t('accessibility-audit'),      severity: 'notice',  rows: [] },
} %}

{% if activeFilter == 'decorative' %}
    {% set groups = {
        'decorative': { label: 'Decorative'|t('accessibility-audit'), severity: 'notice', rows: [] },
    } %}
    {% for row in assetIssues %}
        {% set groups = groups|merge({
            'decorative': groups['decorative']|merge({
                rows: groups['decorative'].rows|merge([{ asset: row.asset, currentAlt: row.currentAlt ?? '', decorative: true }]),
            }),
        }) %}
    {% endfor %}
{% elseif draftsView %}
    {% set groups = {
        'drafts': { label: 'Drafts to review'|t('accessibility-audit'), severity: 'notice', rows: assetIssues },
    } %}
{% else %}
    {% set groups = issueGroups %}
    {% for row in assetIssues %}
        {% for issue in row.issues %}
            {% if groups[issue.ruleId] is defined %}
                {% set groups = groups|merge({
                    (issue.ruleId): groups[issue.ruleId]|merge({
                        rows: groups[issue.ruleId].rows|merge([{ asset: row.asset, issue: issue, currentAlt: row.currentAlt, decorative: row.decorative ?? false }]),
                    }),
                }) %}
            {% endif %}
        {% endfor %}
    {% endfor %}
{% endif %}

{% set siteParam = craft.app.request.getQueryParam('site') %}
{% set allCount = storedStats ? storedStats.withIssues : (activeFilter in ['decorative', 'drafts'] ? 0 : assetIssues|length) %}
{% set filterBase = { site: siteParam, volume: currentVolume, search: currentSearch }|filter(v => v) %}
{% set pdfSourcesOn = isPlus and pdfEnabled and pdfStats %}

{% block actionButton %}
<div class="flex gap-s">
    {% if pdfView %}
        {% if canRunScans and pdfEnabled %}
            <form method="post">
                {{ csrfInput() }}
                {{ actionInput('accessibility-audit/audit/check-pdfs') }}
                {{ redirectInput(url('accessibility-audit/assets', { filter: 'pdf' })) }}
                <button type="submit" class="btn submit">{{ 'Check all PDFs'|t('accessibility-audit') }}</button>
            </form>
        {% endif %}
    {% else %}
        {% if canRunScans %}
            <form method="post">
                {{ csrfInput() }}
                {{ actionInput('accessibility-audit/audit/scan-assets') }}
                {{ redirectInput(url('accessibility-audit/assets')) }}
                <button type="submit" class="btn">{{ 'Scan all assets'|t('accessibility-audit') }}</button>
            </form>
        {% endif %}
        {% if canRunScans and hasApiKey and not draftingRunning and pendingDraftCount > 0 %}
            <form method="post" id="accessibility-audit-draft-form" data-confirm="{{ 'Draft alt text for {n, plural, =1{# image} other{# images}} using your Anthropic API key? Drafts are saved for review, not to the images.'|t('accessibility-audit', { n: pendingDraftCount }) }}">
                {{ csrfInput() }}
                {{ actionInput('accessibility-audit/alt/queue-drafts') }}
                {{ redirectInput(url('accessibility-audit/assets', filterBase|merge(activeFilter ? { filter: activeFilter } : {}))) }}
                {% if currentVolume %}{{ hiddenInput('volume', currentVolume) }}{% endif %}
                <button type="submit" class="btn submit">
                    {{ 'Draft alt text'|t('accessibility-audit') }}
                </button>
            </form>
        {% endif %}
    {% endif %}
</div>
{% endblock %}

{% block sidebar %}
    {% set pdfSources = pdfSourcesOn ? {
        'issues': { label: 'All issues'|t('accessibility-audit'), count: pdfStats.withIssues + pdfStats.notChecked },
        'needs-fixing': { label: 'Need fixing'|t('accessibility-audit'), count: pdfStats.withIssues },
        'not-checked': { label: 'Couldn’t be checked'|t('accessibility-audit'), count: pdfStats.notChecked },
        'passed': { label: 'Passed'|t('accessibility-audit'), count: pdfStats.passed },
    } : {} %}
    <nav aria-label="{{ 'Asset sources'|t('accessibility-audit') }}">
        <ul>
            <li class="heading"><span>{{ 'Images'|t('accessibility-audit') }}</span></li>
            {% set selected = not pdfView and not activeFilter %}
            <li>
                <a href="{{ url('accessibility-audit/assets', filterBase) }}"{% if selected %} class="sel" aria-current="page"{% endif %}>
                    <span class="label">{{ 'All issues'|t('accessibility-audit') }}</span>
                    <span class="badge">{{ allCount }}</span>
                </a>
            </li>
            {% for ruleId, group in issueGroups %}
                {% set ruleCount = storedStats ? (storedStats.byRule[ruleId] ?? 0) : (activeFilter in ['decorative', 'drafts'] ? 0 : group.rows|length) %}
                {% if ruleCount > 0 or activeFilter == ruleId %}
                    {% set selected = activeFilter == ruleId %}
                    <li>
                        <a href="{{ url('accessibility-audit/assets', filterBase|merge({ filter: ruleId })) }}"{% if selected %} class="sel" aria-current="page"{% endif %}>
                            <span class="label">{{ group.label }}</span>
                            <span class="badge">{{ ruleCount }}</span>
                        </a>
                    </li>
                {% endif %}
            {% endfor %}
            {% if draftCount > 0 or draftsView %}
                <li>
                    <a href="{{ url('accessibility-audit/assets', filterBase|merge({ filter: 'drafts' })) }}"{% if draftsView %} class="sel" aria-current="page"{% endif %}>
                        <span class="label">{{ 'Drafts to review'|t('accessibility-audit') }}</span>
                        <span class="badge" id="accessibility-audit-draft-count">{{ draftCount }}</span>
                    </a>
                </li>
            {% endif %}
            {% if decorativeCount > 0 or activeFilter == 'decorative' %}
                {% set selected = activeFilter == 'decorative' %}
                <li>
                    <a href="{{ url('accessibility-audit/assets', filterBase|merge({ filter: 'decorative' })) }}"{% if selected %} class="sel" aria-current="page"{% endif %}>
                        <span class="label">{{ 'Decorative'|t('accessibility-audit') }}</span>
                        <span class="badge" id="accessibility-audit-decorative-count">{{ decorativeCount }}</span>
                    </a>
                </li>
            {% endif %}

            <li class="heading"><span>{{ 'PDFs'|t('accessibility-audit') }}</span></li>
            {% if pdfSources is empty %}
                <li>
                    <a href="{{ url('accessibility-audit/assets', filterBase|merge({ filter: 'pdf' })) }}"{% if pdfView %} class="sel" aria-current="page"{% endif %}>
                        <span class="label">{{ 'PDF checks'|t('accessibility-audit') }}</span>
                    </a>
                </li>
            {% else %}
                {% for status, source in pdfSources %}
                    {% if source.count > 0 or status in ['issues', 'needs-fixing'] or (pdfView and pdfStatus == status) %}
                        {% set selected = pdfView and pdfStatus == status %}
                        {% set params = filterBase|merge({ filter: 'pdf' })|merge(status == 'issues' ? {} : { status: status }) %}
                        <li>
                            <a href="{{ url('accessibility-audit/assets', params) }}"{% if selected %} class="sel" aria-current="page"{% endif %}>
                                <span class="label">{{ source.label }}</span>
                                <span class="badge">{{ source.count }}</span>
                            </a>
                        </li>
                    {% endif %}
                {% endfor %}
            {% endif %}
        </ul>
    </nav>
{% endblock %}

{% block toolbar %}
    {% set pdfFiltersOn = pdfView and pdfSourcesOn %}
    {% if not pdfView or pdfFiltersOn %}
        <form method="get" id="accessibility-audit-asset-toolbar" class="flex flex-nowrap flex-grow" role="search">
            {% if siteParam %}{{ hiddenInput('site', siteParam) }}{% endif %}
            {% if pdfView %}
                {{ hiddenInput('filter', 'pdf') }}
                {% if pdfStatus != 'issues' %}{{ hiddenInput('status', pdfStatus) }}{% endif %}
            {% elseif activeFilter %}
                {{ hiddenInput('filter', activeFilter) }}
            {% endif %}
            <div class="flex-grow texticon search icon clearable">
                <input type="text" class="text fullwidth" name="search" value="{{ currentSearch }}" placeholder="{{ 'Search filenames'|t('accessibility-audit') }}" autocomplete="off" aria-label="{{ 'Search filenames'|t('accessibility-audit') }}">
            </div>
            {% if pdfFiltersOn and (pdfProblemOptions ?? {}) is not empty %}
                <div class="select">
                    <select name="problem" aria-label="{{ 'Problem'|t('accessibility-audit') }}">
                        <option value="">{{ 'Any problem'|t('accessibility-audit') }}</option>
                        {% for ruleId, option in pdfProblemOptions %}
                            <option value="{{ ruleId }}"{% if ruleId == (pdfProblem ?? null) %} selected{% endif %}>{{ '{label} ({count})'|t('accessibility-audit', { label: option.label, count: option.count }) }}</option>
                        {% endfor %}
                    </select>
                </div>
            {% endif %}
            {% if volumes|length > 1 %}
                <div class="select">
                    <select name="volume" aria-label="{{ 'Volume'|t('accessibility-audit') }}">
                        <option value="">{{ 'All volumes'|t('accessibility-audit') }}</option>
                        {% for volume in volumes %}
                            <option value="{{ volume.handle }}"{% if volume.handle == currentVolume %} selected{% endif %}>{{ volume.name }}</option>
                        {% endfor %}
                    </select>
                </div>
            {% endif %}
            <noscript><button type="submit" class="btn">{{ 'Filter'|t('app') }}</button></noscript>
        </form>
        {% js %}
        (function () {
          'use strict';
          var form = document.getElementById('accessibility-audit-asset-toolbar');
          if (!form) return;
          form.querySelectorAll('select').forEach(function (select) {
            select.addEventListener('change', function () { form.submit(); });
          });
        })();
        {% endjs %}
    {% endif %}
{% endblock %}

{% block footer %}
    {% if pdfView %}
        {% if isPlus and pdfEnabled and pdfStats %}
            {% import 'accessibility-audit/_macros' as macros %}
            <div class="flex">
                <span class="accessibility-audit-meta">
                    {{ '{n, plural, =1{# PDF} other{# PDFs}}'|t('accessibility-audit', { n: pdfStats.total }) }}
                    {% if pdfStats.lastChecked %}&middot; {{ 'last checked {date}'|t('accessibility-audit', { date: pdfStats.lastChecked|date('short') }) }}{% endif %}
                    &middot; <a href="https://johnhenry.ie/plugins/accessibility-audit/docs/guide/pdf-checks" target="_blank" rel="noopener">{{ 'How PDF checks work'|t('accessibility-audit') }}{{ macros.newTabNote() }}</a>
                </span>
            </div>
            <div class="flex">
                {% if (pdfPageInfo ?? null) and (pdfTotalPages ?? 0) > 1 %}
                    {% include '_includes/pagination' with {
                        pageInfo: pdfPageInfo,
                        itemLabel: 'PDF'|t('accessibility-audit'),
                        itemsLabel: 'PDFs'|t('accessibility-audit'),
                    } only %}
                {% endif %}
            </div>
        {% endif %}
    {% elseif assetIssues|length %}
            {% set issueCount = stats.withIssues ?? 0 %}
            <div class="flex">
                <span class="accessibility-audit-meta">
                    {{ '{total} images scanned'|t('accessibility-audit', {total: stats.total}) }}
                    &middot;
                    {% if issueCount == -1 %}
                        {{ 'issue count needs a scan on a library this size'|t('accessibility-audit') }}
                    {% else %}
                        {{ '{count} with issues'|t('accessibility-audit', {count: issueCount}) }}
                    {% endif %}
                    {% if storedStats %}&middot; {{ 'last scanned {date}'|t('accessibility-audit', {date: storedStats.dateScanned|date('short')}) }}{% endif %}
                </span>
            </div>
            <div id="accessibility-audit-bulk-bar" class="flex" hidden>
                <span class="visually-hidden" id="accessibility-audit-bulk-count" role="status" aria-live="polite"></span>
                {% if draftsView %}
                    <button type="button" class="btn secondary accessibility-audit-bulk-approve">{{ 'Approve drafts'|t('accessibility-audit') }}</button>
                {% endif %}
                <button type="button" class="btn secondary accessibility-audit-bulk-mark">{{ 'Mark decorative'|t('accessibility-audit') }}</button>
                {% if not draftsView %}
                    <button type="button" class="btn secondary accessibility-audit-bulk-clear">{{ 'Clear decorative'|t('accessibility-audit') }}</button>
                {% endif %}
            </div>
            <div class="flex">
                {% if totalPages > 1 %}
                    {% include '_includes/pagination' with {
                        pageInfo: pageInfo,
                        itemLabel: 'image'|t('accessibility-audit'),
                        itemsLabel: 'images'|t('accessibility-audit'),
                    } only %}
                {% endif %}
                <a href="{{ cpUrl('assets') }}" class="go">{{ 'Open asset library'|t('accessibility-audit') }}</a>
            </div>
    {% endif %}
{% endblock %}

{% block content %}
    {% if not isPlus and not pdfView %}
        <div class="mb-l">
            {% include 'accessibility-audit/_includes/pro-upsell' with {
                feature: 'AI alt text'|t('accessibility-audit'),
                text: 'Draft alt text for your images with Claude, one at a time or the whole missing-alt list in one go, with every draft kept for review. Available on the Plus edition.'|t('accessibility-audit'),
                edition: 'plus',
                inline: true,
            } only %}
        </div>
    {% elseif not hasApiKey and not pdfView %}
        <p class="light mb-l">
            <a href="{{ url('accessibility-audit/settings') }}" class="go">{{ 'Add an Anthropic API key to enable AI alt text generation.'|t('accessibility-audit') }}</a>
        </p>
    {% endif %}
    {% if draftingRunning and not pdfView %}
        <p class="light mb-m" role="status">{{ 'Drafting alt text in the background. Drafts appear under Drafts to review as they are ready.'|t('accessibility-audit') }}</p>
    {% endif %}
    {% if draftsView and failedDraftCount > 0 %}
        <p class="light mb-m">{{ '{n, plural, =1{# image} other{# images}} couldn’t be drafted. They stay under Missing alt to write by hand, and Draft alt text tries them again.'|t('accessibility-audit', { n: failedDraftCount }) }}</p>
    {% endif %}
    {% if not pdfView and assetIssues|length == 0 %}
        <div class="accessibility-audit-assets-empty zilch">
            {% if activeFilter == 'decorative' %}
                <p>{{ 'No images marked decorative.'|t('accessibility-audit') }}</p>
            {% elseif draftsView %}
                <p>{{ 'No drafts to review.'|t('accessibility-audit') }}</p>
            {% elseif storedStats is null %}
                <p>{{ 'No asset scan has run yet'|t('accessibility-audit') }}</p>
                <p class="light">{{ 'Run “Scan all assets” to check every image for alt text. It runs in the background as your queue processes.'|t('accessibility-audit') }}</p>
            {% elseif currentSearch %}
                <p>{{ 'No images with alt-text issues match “{search}”.'|t('accessibility-audit', {search: currentSearch}) }}</p>
            {% elseif currentVolume %}
                <p>{{ 'Every image in this volume has alt text, nice work!'|t('accessibility-audit') }}</p>
            {% else %}
                <p>{{ 'All images have alt text, nice work!'|t('accessibility-audit') }}</p>
            {% endif %}
        </div>
    {% elseif not pdfView %}
        <div id="accessibility-audit-assets-groups" data-view="{{ activeFilter }}">

            <div class="tableview tablepane">
                <table class="data fullwidth">
                <thead>
                    <tr>
                        <th scope="col" class="checkbox-cell thin" style="width:34px">
                            <input type="checkbox" id="accessibility-audit-select-all" class="checkbox" aria-label="{{ 'Select all images'|t('accessibility-audit') }}">
                            <label for="accessibility-audit-select-all"></label>
                        </th>
                        <th scope="col">{{ 'Asset'|t('accessibility-audit') }}</th>
                        <th scope="col">{{ 'Filename'|t('app') }}</th>
                        {% if draftsView %}
                            <th scope="col">{{ 'Draft'|t('accessibility-audit') }}</th>
                        {% else %}
                            {% if not activeFilter %}
                                <th scope="col">{{ 'Problem'|t('accessibility-audit') }}</th>
                            {% endif %}
                            <th scope="col">{{ 'Decorative'|t('accessibility-audit') }}</th>
                        {% endif %}
                        <th scope="col"><span class="visually-hidden">{{ 'Actions'|t('accessibility-audit') }}</span></th>
                    </tr>
                </thead>
                {% for ruleId, group in groups %}
                    {% if group.rows|length > 0 %}
                        <tbody class="accessibility-audit-asset-group" data-rule="{{ ruleId }}">
                            {% for item in group.rows %}
                                {% set asset = item.asset %}
                                {% set isFilename = ruleId == 'asset-alt-filename' %}
                                {% set isDecorative = item.decorative ?? false %}
                                {% set hasDraft = not draftsView and asset.id in (draftedIds ?? []) %}
                                <tr class="accessibility-audit-asset-item{% if isDecorative %} accessibility-audit-asset-item--decorative{% endif %}" data-asset-id="{{ asset.id }}" data-rule="{{ ruleId }}">
                                    <td class="checkbox-cell thin">
                                        <input type="checkbox" id="accessibility-audit-select-{{ asset.id }}" class="checkbox accessibility-audit-row-select" aria-label="{{ 'Select image'|t('accessibility-audit') }}" data-asset-id="{{ asset.id }}">
                                        <label for="accessibility-audit-select-{{ asset.id }}"></label>
                                    </td>
                                    <th scope="row">
                                        {% if hasDraft %}
                                            <span class="flex flex-nowrap accessibility-audit-has-draft">
                                                <span data-icon="draft" class="icon" role="img" aria-label="{{ 'Alt text draft waiting for review'|t('accessibility-audit') }}" title="{{ 'Alt text draft waiting for review'|t('accessibility-audit') }}"></span>
                                                {{ elementChip(asset, { showStatus: false, hyperlink: true, attributes: { class: ['chromeless'] } }) }}
                                            </span>
                                        {% else %}
                                            {{ elementChip(asset, { showStatus: false, hyperlink: true, attributes: { class: ['chromeless'] } }) }}
                                        {% endif %}
                                    </th>
                                    <td>{{ asset.filename }}</td>
                                    {% if draftsView %}
                                        <td class="accessibility-audit-draft-cell">
                                            <span class="accessibility-audit-draft-text">{{ item.draft.standardAlt }}</span>
                                            {% if item.notes is not empty %}
                                                <span class="token accessibility-audit-problem"><span class="accessibility-audit-legend__dot accessibility-audit-legend__dot--warning" aria-hidden="true"></span>{{ 'Check'|t('accessibility-audit') }}</span>
                                                <ul class="light smalltext accessibility-audit-draft-notes">
                                                    {% for note in item.notes %}
                                                        <li>{{ note }}</li>
                                                    {% endfor %}
                                                </ul>
                                            {% endif %}
                                        </td>
                                        <td class="accessibility-audit-asset-action">
                                            <button type="button" class="btn small accessibility-audit-edit-btn" data-asset-id="{{ asset.id }}">{{ 'Review'|t('accessibility-audit') }}</button>
                                        </td>
                                    {% else %}
                                        {% if not activeFilter %}
                                            <td><span class="token accessibility-audit-problem"><span class="accessibility-audit-legend__dot accessibility-audit-legend__dot--{{ group.severity }}" aria-hidden="true"></span>{{ group.label }}</span></td>
                                        {% endif %}
                                        <td class="accessibility-audit-asset-decorative">
                                            <button type="button"
                                                    class="accessibility-audit-decorative-switch{% if isDecorative %} on{% endif %}"
                                                    role="switch"
                                                    aria-checked="{{ isDecorative ? 'true' : 'false' }}"
                                                    aria-label="{{ 'Mark as decorative'|t('accessibility-audit') }}"
                                                    data-asset-id="{{ asset.id }}">
                                                <span class="accessibility-audit-decorative-switch__knob"></span>
                                            </button>
                                        </td>
                                        <td class="accessibility-audit-asset-action">
                                            <button type="button" class="btn small accessibility-audit-edit-btn"{% if isDecorative %} hidden{% endif %}
                                                    data-asset-id="{{ asset.id }}">
                                                {{ hasDraft ? 'Review'|t('accessibility-audit') : (isFilename ? 'Rewrite'|t('accessibility-audit') : 'Add alt'|t('accessibility-audit')) }}
                                            </button>
                                        </td>
                                    {% endif %}
                                </tr>
                            {% endfor %}
                        </tbody>
                    {% endif %}
                {% endfor %}
            </table>
            </div>
        </div>
    {% endif %}

    {% if pdfView %}
        {% include 'accessibility-audit/_assets/pdfs' with {
            isPlus: isPlus,
            pdfEnabled: pdfEnabled,
            pdfStats: pdfStats,
            pdfStatus: pdfStatus,
            pdfProblem: pdfProblem ?? null,
            pdfRows: pdfRows ?? [],
            pdfReasons: pdfReasons ?? {},
            pdfPageInfo: pdfPageInfo ?? null,
            pdfTotalPages: pdfTotalPages ?? 0,
            filterBase: filterBase,
        } only %}
    {% endif %}

{% js %}
(function () {
  const generateUrl     = {{ actionUrl('accessibility-audit/alt/generate')|json_encode|raw }};
  const discardDraftUrl = {{ actionUrl('accessibility-audit/alt/discard-draft')|json_encode|raw }};
  const setDecorativeUrl = {{ actionUrl('accessibility-audit/alt/set-decorative')|json_encode|raw }};
  const setDecorativeBulkUrl = {{ actionUrl('accessibility-audit/alt/set-decorative-bulk')|json_encode|raw }};
  const approveDraftsUrl = {{ actionUrl('accessibility-audit/alt/approve-drafts')|json_encode|raw }};
  const networkError = {{ 'Network error. Check your connection and try again.'|t('accessibility-audit')|json_encode|raw }};
  const csrfName    = window.Craft ? Craft.csrfTokenName  : (window.csrfTokenName  || 'CRAFT_CSRF_TOKEN');
  const csrfValue   = window.Craft ? Craft.csrfTokenValue : (window.csrfTokenValue || '');

  // The length the long-alt check reports on, so the field counts against the
  // number the report will quote back. Not a cap: Craft's own alt field sets
  // no limit, and truncating an editor mid-description to a number the rule
  // does not even use would be its own bug.
  const ALT_GUIDELINE = {{ altGuideline|json_encode|raw }};
  const activeView = {{ activeFilter|json_encode|raw }};
  const emptyAllHaveAlt   = {{ 'All images now have alt text, nice work!'|t('accessibility-audit')|json_encode|raw }};
  const emptyNoDecorative = {{ 'No images marked decorative.'|t('accessibility-audit')|json_encode|raw }};
  const emptyNoDrafts     = {{ 'No drafts left to review.'|t('accessibility-audit')|json_encode|raw }};
  const emptyMessage = activeView === 'decorative'
    ? emptyNoDecorative
    : (activeView === 'drafts' ? emptyNoDrafts : emptyAllHaveAlt);

  function post(url, data) {
    const fd = new FormData();
    fd.append(csrfName, csrfValue);
    Object.entries(data).forEach(([k, v]) => {
      if (Array.isArray(v)) {
        v.forEach((item) => fd.append(k + '[]', item));
      } else {
        fd.append(k, v);
      }
    });
    return fetch(url, {
      method: 'POST',
      body: fd,
      headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
    }).then(r => r.json());
  }

  /* Shared with cp.js and the frontend overlay via accessibility-audit-shared.js */
  var esc = window.AccessibilityAuditShared.escHtml;

  // Drafting spends API credit on every image in the count, so it asks first.
  const draftForm = document.getElementById('accessibility-audit-draft-form');
  if (draftForm) {
    draftForm.addEventListener('submit', (e) => {
      if (!window.confirm(draftForm.dataset.confirm)) e.preventDefault();
    });
  }

  // Counts up rather than down. There is no ceiling to run out of, and the
  // useful number when trimming is how far past the guideline the text sits,
  // which is what the report quotes.
  function renderCount(input, out) {
    const n = [...input.value].length;
    const over = n - ALT_GUIDELINE;

    out.textContent = over > 0
      ? Craft.t('accessibility-audit', '{n} characters, {over} over', { n: n, over: over })
      : Craft.t('accessibility-audit', '{n} characters', { n: n });
    out.classList.toggle('accessibility-audit-alt-count--low', over > 0);
  }

  /* The next row still waiting for alt text, for Save and next. Decorative rows
     are skipped: their button is hidden, as there is nothing to write. */
  function nextEditableRow(row) {
    const rows = [...document.querySelectorAll('.accessibility-audit-asset-item')];
    return rows.slice(rows.indexOf(row) + 1).find((r) => {
      const btn = r.querySelector('.accessibility-audit-edit-btn');
      return btn && !btn.hidden;
    }) || null;
  }

  function openSlideout(row) {
    if (!row || !window.Craft || !Craft.CpScreenSlideout) return;

    const next = nextEditableRow(row);
    let saveAndNext = false;

    const slideout = new Craft.CpScreenSlideout('accessibility-audit/alt/edit', {
      params: { assetId: row.dataset.assetId },
    });

    slideout.on('load', () => {
      wireAltEditor(slideout.$container[0], row.dataset.assetId, () => {
        if (activeView === 'drafts') removeRow(row);
      });

      // Craft's slideout has one submit button; Save and next sits beside it and
      // submits the same form, then opens the next image once this one is saved.
      if (next && slideout.$saveBtn && !slideout.$container[0].querySelector('.accessibility-audit-save-next')) {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'btn accessibility-audit-save-next';
        btn.textContent = {{ 'Save and next'|t('accessibility-audit')|json_encode|raw }};
        btn.addEventListener('click', () => {
          saveAndNext = true;
          slideout.submit();
        });
        slideout.$saveBtn[0].before(btn);
      }
    });

    let saved = null;

    // The slideout hands focus back to the page body, so it goes back to the row:
    // its own button, or where the row has left the list, the next row's.
    slideout.on('close', () => {
      if (saveAndNext && next) return;
      const rowGone = (saved && !saved.decorative) || !document.body.contains(row) || row.dataset.removing;
      const target = rowGone ? next : row;
      const btn = target && document.body.contains(target)
        ? (target.querySelector('.accessibility-audit-edit-btn:not([hidden])') || target.querySelector('.accessibility-audit-decorative-switch'))
        : null;
      if (btn) btn.focus();
    });

    slideout.on('submit', (ev) => {
      const data = (ev.response && ev.response.data) || {};
      saved = data;

      // Marking decorative retires a draft too, so on the drafts list the row
      // goes either way.
      if (data.decorative && activeView !== 'drafts') {
        applyDecorativeUi(row, true);
      } else {
        removeRow(row);
      }

      if (saveAndNext && next && document.body.contains(next)) {
        openSlideout(next);
      }
    });
  }

  /* Hooks up the slideout's editor: the character count, the decorative switch
     hiding the alt field, the AI suggestions with any stored draft shown
     straight away (its Standard version put into an empty field), and
     Discard draft, which takes that version back out. Inputs are namespaced
     by the slideout, so everything is found by class within its container. */
  function wireAltEditor(container, assetId, onDiscard) {
    const editor = container.querySelector('.accessibility-audit-alt-editor');
    if (!editor) return;

    const input = editor.querySelector('textarea');
    const count = editor.querySelector('.accessibility-audit-alt-editor__count');
    const altBlock = editor.querySelector('.accessibility-audit-alt-editor__alt');
    const sw = editor.querySelector('.lightswitch');

    if (input && count) {
      input.addEventListener('input', () => renderCount(input, count));
      renderCount(input, count);
    }

    // Craft's lightswitch changes state without a native event, so its
    // aria-checked attribute is watched instead.
    if (sw && altBlock) {
      new MutationObserver(() => {
        altBlock.hidden = sw.getAttribute('aria-checked') === 'true';
      }).observe(sw, { attributes: true, attributeFilter: ['aria-checked'] });
    }

    if (!input || !window.AccessibilityAuditAltSuggestions) return;

    let draft = null;
    try {
      draft = editor.dataset.draft ? JSON.parse(editor.dataset.draft) : null;
    } catch (e) {
      draft = null;
    }

    const suggestions = window.AccessibilityAuditAltSuggestions.wire(editor, {
      assetId: assetId,
      url: generateUrl,
      input: input,
      guideline: ALT_GUIDELINE,
      initial: draft,
      prefill: true,
    });

    const discardBtn = editor.querySelector('.accessibility-audit-alt-editor__discard');
    if (!discardBtn) return;

    discardBtn.addEventListener('click', async () => {
      discardBtn.disabled = true;
      discardBtn.classList.add('loading');

      let data;
      try {
        data = await post(discardDraftUrl, { assetId: assetId });
      } catch (e) {
        data = { success: false, error: networkError };
      }

      discardBtn.classList.remove('loading');
      if (!data.success) {
        discardBtn.disabled = false;
        discardBtn.focus();
        if (window.Craft && Craft.cp) Craft.cp.displayError(data.error);
        return;
      }

      editor.querySelectorAll('.accessibility-audit-alt-editor__suggestion, .accessibility-audit-alt-editor__reasons')
        .forEach((el) => { el.hidden = true; });
      if (suggestions) suggestions.undoPrefill();
      discardBtn.remove();
      input.focus();
      if (window.Craft && Craft.cp) Craft.cp.displayNotice(data.message);
      if (onDiscard) onDiscard();
    });
  }

  function removeRow(row) {
    if (row.dataset.removing) return;
    row.dataset.removing = '1';
    row.style.transition = 'opacity 0.3s';
    row.style.opacity    = '0';
    if (activeView === 'drafts') bumpDraftCount();
    setTimeout(() => {
      const section = row.closest('.accessibility-audit-asset-group');
      row.remove();
      if (section && section.querySelectorAll('.accessibility-audit-asset-item').length === 0) {
        section.remove();
      }
      const groups = document.getElementById('accessibility-audit-assets-groups');
      if (groups && groups.querySelectorAll('.accessibility-audit-asset-item').length === 0) {
        groups.innerHTML =
          '<div class="accessibility-audit-assets-empty zilch"><p class="accessibility-audit-empty-title">' + esc(emptyMessage) + '</p></div>';
      }
      updateDecorativeCount();
      updateBulkBar();
    }, 300);
  }

  // The badge counts drafts across every page, so it goes down by one per row
  // rather than being recounted from the rows on this one.
  function bumpDraftCount() {
    const badge = document.getElementById('accessibility-audit-draft-count');
    if (!badge) return;
    badge.textContent = String(Math.max(0, (parseInt(badge.textContent, 10) || 0) - 1));
  }

  function updateDecorativeCount() {
    if (activeView !== 'decorative') return;
    const groups = document.getElementById('accessibility-audit-assets-groups');
    const n = groups ? groups.querySelectorAll('.accessibility-audit-asset-item').length : 0;
    const chip = document.getElementById('accessibility-audit-decorative-count');
    if (chip) chip.textContent = String(n);
  }

  async function toggleDecorative(sw) {
    const row = sw.closest('.accessibility-audit-asset-item');
    if (!row || sw.disabled) return;

    const next = !sw.classList.contains('on');
    sw.disabled = true;

    const data = await post(setDecorativeUrl, { assetId: sw.dataset.assetId, decorative: next ? '1' : '' });
    sw.disabled = false;

    if (!data.success) {
      if (window.Craft && Craft.cp) Craft.cp.displayError(data.error);
      return;
    }

    if (window.Craft && Craft.cp) {
      Craft.cp.displayNotice(next
        ? {{ 'Marked decorative.'|t('accessibility-audit')|json_encode|raw }}
        : {{ 'No longer decorative.'|t('accessibility-audit')|json_encode|raw }});
    }

    if (activeView === 'decorative' && !next) {
      removeRow(row);
      return;
    }

    applyDecorativeUi(row, next);
  }

  function applyDecorativeUi(row, on) {
    const sw = row.querySelector('.accessibility-audit-decorative-switch');
    if (sw) {
      sw.classList.toggle('on', on);
      sw.setAttribute('aria-checked', on ? 'true' : 'false');
    }

    row.classList.toggle('accessibility-audit-asset-item--decorative', on);

    const editBtn = row.querySelector('.accessibility-audit-edit-btn');
    if (editBtn) editBtn.hidden = on;
  }

  function selectedRowCheckboxes() {
    return [...document.querySelectorAll('.accessibility-audit-row-select:checked')];
  }

  function updateBulkBar() {
    const bar = document.getElementById('accessibility-audit-bulk-bar');
    if (!bar) return;

    const all      = [...document.querySelectorAll('.accessibility-audit-row-select')];
    const selected = all.filter((cb) => cb.checked);

    bar.hidden = selected.length === 0;

    all.forEach((cb) => {
      const row = cb.closest('.accessibility-audit-asset-item');
      if (row) row.classList.toggle('sel', cb.checked);
    });

    const label = document.getElementById('accessibility-audit-bulk-count');
    if (label && window.Craft) {
      label.textContent = Craft.t('accessibility-audit', '{n} selected', { n: selected.length });
    }

    const selectAll = document.getElementById('accessibility-audit-select-all');
    if (selectAll) {
      selectAll.checked = all.length > 0 && selected.length === all.length;
      selectAll.indeterminate = selected.length > 0 && selected.length < all.length;
    }
  }

  function setBulkBusy(busy) {
    document.querySelectorAll('#accessibility-audit-bulk-bar .btn')
      .forEach((b) => { b.disabled = busy; });
  }

  async function applyBulk(decorative) {
    const checkboxes = selectedRowCheckboxes();
    if (!checkboxes.length) return;

    const ids = checkboxes.map((cb) => cb.dataset.assetId);

    if (decorative && window.Craft) {
      const message = Craft.t(
        'accessibility-audit',
        'Marking images decorative hides missing-alt warnings. Only mark images that carry no information. Mark {n} images decorative?',
        { n: ids.length },
      );
      if (!window.confirm(message)) return;
    }

    setBulkBusy(true);
    const data = await post(setDecorativeBulkUrl, { assetIds: ids, decorative: decorative ? '1' : '' });
    setBulkBusy(false);

    if (!data.success) {
      if (window.Craft && Craft.cp) Craft.cp.displayError(data.error);
      return;
    }

    checkboxes.forEach((cb) => {
      const row = cb.closest('.accessibility-audit-asset-item');
      cb.checked = false;
      if (!row) return;
      // Unmarking takes a row off the decorative list; marking takes one off
      // the drafts list, as a decorative image's draft is dropped.
      if ((activeView === 'decorative' && !decorative) || (activeView === 'drafts' && decorative)) {
        removeRow(row);
        return;
      }
      applyDecorativeUi(row, decorative);
    });
    updateBulkBar();

    if (window.Craft && Craft.cp) {
      const notice = decorative
        ? Craft.t('accessibility-audit', '{n} images marked decorative.', { n: data.count })
        : Craft.t('accessibility-audit', '{n} images no longer decorative.', { n: data.count });
      Craft.cp.displayNotice(notice);
    }
  }

  {% verbatim %}
  // Saves the Standard version of each selected draft as the image's alt
  // text. Drafts Claude flagged for checking are left on the list for a person.
  // Kept out of Twig's reach, as the plural messages carry "{#", which Twig
  // reads as the start of a comment.
  async function approveDrafts() {
    const checkboxes = selectedRowCheckboxes();
    if (!checkboxes.length) return;

    const message = Craft.t(
      'accessibility-audit',
      '{n, plural, =1{Save the Standard draft as alt text on # image?} other{Save the Standard draft as alt text on # images?}} Drafts flagged Check are skipped.',
      { n: checkboxes.length },
    );
    if (!window.confirm(message)) return;

    setBulkBusy(true);
    let data;
    try {
      data = await post(approveDraftsUrl, { assetIds: checkboxes.map((cb) => cb.dataset.assetId) });
    } catch (e) {
      data = { success: false, error: networkError };
    }
    setBulkBusy(false);

    if (!data.success) {
      if (window.Craft && Craft.cp) Craft.cp.displayError(data.error);
      return;
    }

    const approved = (data.approvedIds || []).map(String);
    checkboxes.forEach((cb) => {
      cb.checked = false;
      const row = cb.closest('.accessibility-audit-asset-item');
      if (row && approved.includes(cb.dataset.assetId)) removeRow(row);
    });
    updateBulkBar();

    if (window.Craft && Craft.cp) {
      let notice = Craft.t('accessibility-audit', '{n, plural, =1{Approved # draft.} other{Approved # drafts.}}', { n: data.approved });
      if (data.skipped > 0) {
        notice += ' ' + Craft.t('accessibility-audit', '{n, plural, =1{# draft needs a check before it can be saved.} other{# drafts need a check before they can be saved.}}', { n: data.skipped });
      }
      Craft.cp.displayNotice(notice);
    }
  }
  {% endverbatim %}

  (function () {
    const selectAll = document.getElementById('accessibility-audit-select-all');
    if (selectAll) {
      selectAll.addEventListener('change', () => {
        document.querySelectorAll('.accessibility-audit-row-select')
          .forEach((cb) => { cb.checked = selectAll.checked; });
        updateBulkBar();
      });
    }

    // Row checkboxes are delegated so the bar stays in sync no matter which
    // group a row sits in.
    document.addEventListener('change', (e) => {
      if (e.target.classList && e.target.classList.contains('accessibility-audit-row-select')) {
        updateBulkBar();
      }
    });
  })();

  // ── Delegated row-action clicks ────────────────────────────────────────────
  document.addEventListener('click', (e) => {
    const decoSwitch = e.target.closest('.accessibility-audit-decorative-switch');
    if (decoSwitch) { toggleDecorative(decoSwitch); return; }
    const editBtn = e.target.closest('.accessibility-audit-edit-btn');
    if (editBtn) { openSlideout(editBtn.closest('.accessibility-audit-asset-item')); return; }
    const bulkApprove = e.target.closest('.accessibility-audit-bulk-approve');
    if (bulkApprove) { approveDrafts(); return; }
    const bulkMark = e.target.closest('.accessibility-audit-bulk-mark');
    if (bulkMark) { applyBulk(true); return; }
    const bulkClear = e.target.closest('.accessibility-audit-bulk-clear');
    if (bulkClear) { applyBulk(false); return; }
  });
})();
{% endjs %}
{% endblock %}
