{% extends '_layouts/cp' %}

{% set title = 'Accessibility Audit'|t('accessibility-audit') %}
{% set selectedSubnavItem = 'overview' %}
{% set crumbs = [
    { label: 'Accessibility Audit'|t('accessibility-audit'), url: cpUrl('accessibility-audit') },
    { label: 'Overview'|t('accessibility-audit') },
] %}


{% if sites|length > 1 %}
    {% set crumbs = [{
        id: 'site-crumb',
        icon: 'world',
        label: requestedSite.name|t('site'),
        menu: { items: siteMenuItems(sites, requestedSite), label: 'Select site'|t('app') },
    }]|merge(crumbs ?? []) %}
{% endif %}


{% import 'accessibility-audit/_macros' as macros %}

{% block pageTitle %}
    {% if title is defined and title|length %}
        <h1 id="page-heading" class="screen-title flex items-center" title="{{ title }}">{{ title }}
            {% if isPro %}
                <span class="accessibility-audit-pro--solid">
                    <span aria-hidden="true">{{ 'Pro'|t('accessibility-audit') }}</span>
                    <span class="visually-hidden">{{ '{edition} edition'|t('accessibility-audit', { edition: craft.a11y.editionName('pro') }) }}</span>
                </span>
            {% else %}
                {% set currentEdition = craft.a11y.editionName(edition) %}
                {% set nextEdition = craft.a11y.editionName(edition == 'lite' ? 'standard' : 'pro') %}
                <a href="{{ cpUrl('plugin-store/accessibility-audit') }}"
                   class="accessibility-audit-standard--outlined"
                   title="{{ 'Upgrade to {edition}'|t('accessibility-audit', { edition: nextEdition }) }}">
                    <span class="accessibility-audit-standard__swap" aria-hidden="true">
                        <span class="accessibility-audit-standard__now">{{ currentEdition }}</span>
                        <span class="accessibility-audit-standard__pro">{{ edition == 'lite' ? 'Upgrade'|t('accessibility-audit') : 'Go Pro'|t('accessibility-audit') }}</span>
                    </span>
                    <span class="visually-hidden">{{ '{edition} edition'|t('accessibility-audit', { edition: currentEdition }) }}. {{ 'Upgrade to {edition}'|t('accessibility-audit', { edition: nextEdition }) }}.</span></a>
            {% endif %}</h1>
    {% endif %}
    
{% endblock %}

{% block actionButton %}
<div class="accessibility-audit-toolbar">
    {% if scanLimit is not null %}
        {% set overLimit = scannedElementCount >= scanLimit %}
        <a href="{{ cpUrl('plugin-store/accessibility-audit') }}"
           class="accessibility-audit-usage-badge{% if overLimit %} accessibility-audit-usage-badge--full{% endif %}"
           title="{{ 'The Lite edition scans up to {n} pages. Upgrade to Standard for unlimited scanning.'|t('accessibility-audit', {n: scanLimit}) }}">
            {% if isMultiSite %}
                {{ '{used}/{limit} pages scanned across all sites'|t('accessibility-audit', {used: scannedElementCount, limit: scanLimit}) }}
            {% else %}
                {{ '{used}/{limit} pages scanned'|t('accessibility-audit', {used: scannedElementCount, limit: scanLimit}) }}
            {% endif %}
            <span class="accessibility-audit-usage-badge__pro" aria-hidden="true">{{ 'Upgrade'|t('accessibility-audit') }}</span>
            <span class="visually-hidden">{{ 'Upgrade to {edition}'|t('accessibility-audit', { edition: craft.a11y.editionName('standard') }) }}</span>
        </a>
    {% endif %}
    <button class="btn submit" data-accessibility-audit-scan-all data-site-id="{{ siteId }}">
        {{ 'Scan All Pages'|t('accessibility-audit') }}
    </button>
    <a href="{{ actionUrl('accessibility-audit/audit/export', {siteId: siteId}) }}" class="btn">
        {{ 'Export CSV'|t('accessibility-audit') }}
    </a>
</div>
{% endblock %}

{% block main %}
{% if summary.scannedCount == 0 %}

    <div class="pane">
    <div class="accessibility-audit-zilch">
        <div class="accessibility-audit-zilch__icon" aria-hidden="true">
            {{ svg(craft.app.plugins.getPluginIconSvg('accessibility-audit'), sanitize=true) }}
        </div>

        <h2 class="accessibility-audit-zilch__title">{{ 'No scans yet'|t('accessibility-audit') }}</h2>
        
        <p class="accessibility-audit-zilch__lede">
            {% if isMultiSite %}
                {{ 'Run your first audit of {site} to see its accessibility score, the issues behind it, and a WCAG conformance breakdown.'|t('accessibility-audit', {site: requestedSite.name}) }}
            {% else %}
                {{ 'Run your first audit to see your accessibility score, the issues behind it, and a WCAG conformance breakdown.'|t('accessibility-audit') }}
            {% endif %}
        </p>

        <ol class="accessibility-audit-steps">
            <li class="accessibility-audit-steps__item">
                <span class="accessibility-audit-steps__num" aria-hidden="true">1</span>
                <span>{{ 'Scan your pages. Every entry is rendered and checked against WCAG {level}.'|t('accessibility-audit', {level: wcagLevel}) }}</span>
            </li>
            <li class="accessibility-audit-steps__item">
                <span class="accessibility-audit-steps__num" aria-hidden="true">2</span>
                <span>{{ 'Work the issues list. Rules are ranked by the points you gain from fixing them.'|t('accessibility-audit') }}</span>
            </li>
            <li class="accessibility-audit-steps__item">
                <span class="accessibility-audit-steps__num" aria-hidden="true">3</span>
                <span>{{ 'Fix and re-scan. Anything you clear moves to Resolved so you can show the progress.'|t('accessibility-audit') }}</span>
            </li>
        </ol>

    
        <button class="btn submit accessibility-audit-zilch__btn"
                data-accessibility-audit-scan-all
                data-site-id="{{ siteId }}">
            {{ 'Scan All Pages'|t('accessibility-audit') }}
        </button>

        <p class="accessibility-audit-zilch__cli light">
            {{ 'On a large site, run it from the command line instead:'|t('accessibility-audit') }}
            <code>php craft accessibility-audit/audit/scan-all</code>
        </p>
    </div>
    </div>
{% else %}

<div class="accessibility-audit-stack">


{% set openTotal = summary.errorCount + summary.warningCount + summary.noticeCount %}
{% set scoreBand = macros.scoreClass(summary.avgScore) %}
{% set scoreFillMap = {good: 'pass', fair: 'warn', poor: 'error'} %}


{% set levelRank = {'A': 1, 'AA': 2, 'AAA': 3} %}
{% set targetRank = levelRank[wcagLevel] ?? 2 %}

<div class="accessibility-audit-kpi">

    <div class="pane accessibility-audit-kpi__cell">
        <span class="accessibility-audit-col-label">
            {{ 'Average page score'|t('accessibility-audit') }}
            <span class="info">{{ 'Each scanned page starts at 100 and loses points for every definite failure: 10 for an error, 4 for a warning and 1 for a notice. This is the average across your pages. The Level scores count only that level’s criteria, and Level AA includes Level A. Potential issues waiting for a person to check them do not count.'|t('accessibility-audit') }}</span>
        </span>
        <span class="accessibility-audit-baseline">
            <span class="accessibility-audit-stat accessibility-audit-stat-value--{{ scoreBand }}">{{ summary.avgScore }}</span>
            <span class="accessibility-audit-kpi__unit">/100</span>
        </span>
        <div class="accessibility-audit-progress accessibility-audit-progress--flush"><div class="accessibility-audit-progress__fill accessibility-audit-progress__fill--{{ scoreFillMap[scoreBand] }}" style="width:{{ summary.avgScore }}%"></div></div>
        {% if targetScore > 0 %}
            <span class="accessibility-audit-kpi__sub">
                {% if summary.avgScore >= targetScore %}
                    {{ 'target {n} met'|t('accessibility-audit', {n: targetScore}) }}
                {% else %}
                    {{ '{gap} to target {n}'|t('accessibility-audit', {gap: targetScore - summary.avgScore, n: targetScore}) }}
                {% endif %}
            </span>
        {% endif %}
    </div>
    
    {% for row in [
        { label: 'Level A'|t('accessibility-audit'),   code: 'A',   score: summary.avgScoreA,   failing: summary.failingCriteriaA },
        { label: 'Level AA'|t('accessibility-audit'),  code: 'AA',  score: summary.avgScoreAA,  failing: summary.failingCriteriaAA },
        { label: 'Level AAA'|t('accessibility-audit'), code: 'AAA', score: summary.avgScoreAAA, failing: summary.failingCriteriaAAA },
    ] %}
        {% if (levelRank[row.code] ?? 1) <= targetRank %}
            {% set isTarget = row.code == wcagLevel %}
            <div class="pane accessibility-audit-kpi__cell{% if isTarget %} accessibility-audit-kpi__cell--target{% endif %}">
                <span class="accessibility-audit-col-label">
                    {{ isTarget ? '{level} (target)'|t('accessibility-audit', {level: row.label}) : row.label }}
                </span>
                <span class="accessibility-audit-baseline">
                    <span class="accessibility-audit-stat {{ row.failing == 0 ? 'accessibility-audit-stat-value--good' : 'accessibility-audit-stat--ink' }}">{{ row.failing }}</span>
                    <span class="accessibility-audit-kpi__unit">{{ '{n, plural, =1{criterion failing} other{criteria failing}}'|t('accessibility-audit', {n: row.failing}) }}</span>
                </span>
                <span class="accessibility-audit-kpi__sub">
                    {{ 'Pages average {n}%'|t('accessibility-audit', {n: row.score}) }}
                </span>
            </div>
        {% endif %}
    {% endfor %}
    
    <div class="pane accessibility-audit-kpi__cell">
        <span class="accessibility-audit-col-label">{{ 'Open issues'|t('accessibility-audit') }}</span>
        <span class="accessibility-audit-baseline">
            <span class="accessibility-audit-stat accessibility-audit-stat--ink">{{ openTotal }}</span>
        </span>
        {% if openTotal > 0 %}
        <div class="accessibility-audit-dist" role="presentation">
            <div class="accessibility-audit-dist__seg--error"   style="width:{{ (summary.errorCount / openTotal * 100)|round(2) }}%"></div>
            <div class="accessibility-audit-dist__seg--warning" style="width:{{ (summary.warningCount / openTotal * 100)|round(2) }}%"></div>
            <div class="accessibility-audit-dist__seg--notice"  style="width:{{ (summary.noticeCount / openTotal * 100)|round(2) }}%"></div>
        </div>
        {% endif %}
        <span class="accessibility-audit-kpi__sub accessibility-audit-kpi__sub--counts">
            <span><strong class="accessibility-audit-kpi__ct--error">{{ summary.errorCount }}</strong> {{ 'errors'|t('accessibility-audit') }}</span>
            <span><strong class="accessibility-audit-kpi__ct--warning">{{ summary.warningCount }}</strong> {{ 'warnings'|t('accessibility-audit') }}</span>
            <span><strong class="accessibility-audit-kpi__ct--notice">{{ summary.noticeCount }}</strong> {{ 'notices'|t('accessibility-audit') }}</span>
        </span>
    </div>

</div>

{% if en301549 ?? false %}
    <p class="light accessibility-audit-en-note">
        {%- if targetRank >= 2 -%}
            {{ 'Targeting Level AA, so this also covers EN 301 549 clause 9, the web part of the European standard.'|t('accessibility-audit') }}
        {%- else -%}
            {{ 'EN 301 549 needs Level AA. You are targeting Level A, so this will not cover it.'|t('accessibility-audit') }}
        {%- endif -%}
    </p>
{% endif %}

{% set sweeping = coverage.sweeping ?? false %}
{% set settled = (coverage.scanned ?? 0) > 0 and not sweeping %}
{% set allClear = openTotal == 0 and (pendingPotential ?? 0) == 0 and summary.avgScore >= 100 and settled %}

{% if sweeping %}
    <div class="accessibility-audit-panelnote accessibility-audit-panelnote--waiting">
        <div class="accessibility-audit-panelnote__text">
            <p class="accessibility-audit-panelnote__lead">
                {{ 'A scan is running. {n} of {total} pages so far.'|t('accessibility-audit', { n: coverage.scanned, total: coverage.scannable }) }}
            </p>
            <p class="accessibility-audit-panelnote__body">
                {{ 'Everything above is worked out from the pages done so far, so it will move as the scan works through the rest.'|t('accessibility-audit') }}
                <a href="{{ cpUrl('accessibility-audit/issues', { site: siteHandle, tab: 'pages' }) }}">{{ 'See which pages have been scanned'|t('accessibility-audit') }}</a>
            </p>
        </div>
    </div>
{% endif %}

{% if (pendingPotential ?? 0) > 0 %}
    <div class="accessibility-audit-panelnote accessibility-audit-panelnote--waiting">
        <div class="accessibility-audit-panelnote__text">
            <p class="accessibility-audit-panelnote__lead warning has-icon">
                <span class="icon" aria-hidden="true"></span>
                <span>{{ '{n, plural, =1{# question} other{# questions}} across {p, plural, =1{# page} other{# pages}} {n, plural, =1{is} other{are}} still waiting on a person.'|t('accessibility-audit', { n: pendingPotential, p: potentialPages }) }}</span>
            </p>
            <p class="accessibility-audit-panelnote__body">
                {{ 'These fall into {k, plural, =1{# kind of question} other{# kinds of question}} on the review screen.'|t('accessibility-audit', { k: potentialKinds }) }}
                {{ 'They don’t affect the score until you answer them.'|t('accessibility-audit') }}
            </p>
        </div>
        <a href="{{ cpUrl('accessibility-audit/potential', { site: siteHandle }) }}" class="go accessibility-audit-panelnote__action">{{ 'Review them'|t('accessibility-audit') }}</a>
    </div>
{% elseif allClear %}
    <div class="accessibility-audit-panelnote accessibility-audit-panelnote--good">
        <svg class="accessibility-audit-panelnote__tick" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
            <path d="M3 13 L9 19 L21 5" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <p class="accessibility-audit-panelnote__lead">
            {{ 'Nothing failing and nothing left to answer. Every question has been through a person, so there is nothing sitting behind that score.'|t('accessibility-audit') }}
        </p>
        <button type="button" class="btn small accessibility-audit-panelnote__flourish" data-accessibility-audit-confetti hidden>
            {{ 'Celebrate'|t('accessibility-audit') }}
        </button>
    </div>
{% endif %}
    {% set assetsUrl = 'accessibility-audit/assets' %}
    {% set pdfsClear = pdfStats is null or (pdfStats.withIssues == 0 and pdfStats.notChecked == 0) %}
    {% set pdfTiles = [] %}
        {% if pdfStats %}
            {% if pdfStats.withIssues > 0 %}
                {% set pdfTiles = pdfTiles|merge([{ n: pdfStats.withIssues, label: 'Need fixing'|t('accessibility-audit'), tone: 'warning', status: 'needs-fixing' }]) %}
            {% endif %}
            {% if pdfStats.notChecked > 0 %}
                {% set pdfTiles = pdfTiles|merge([{ n: pdfStats.notChecked, label: 'Couldn’t be checked'|t('accessibility-audit'), tone: 'neutral', status: 'not-checked' }]) %}
            {% endif %}
            {% if pdfStats.passed > 0 %}
                {% set pdfTiles = pdfTiles|merge([{ n: pdfStats.passed, label: 'Passed'|t('accessibility-audit'), tone: 'good', status: 'passed' }]) %}
            {% endif %}
        {% endif %}
    {% set pdfGroup %}
                {% if pdfTiles is not empty %}
                    <div class="accessibility-audit-assettiles__group">
                        <h3 class="accessibility-audit-col-label">{{ 'PDFs'|t('accessibility-audit') }}</h3>
                        <div class="accessibility-audit-assettiles__row">
                            {% for tile in pdfTiles %}
                                <a class="accessibility-audit-assettile accessibility-audit-assettile--{{ tile.tone }}" href="{{ cpUrl(assetsUrl, {filter: 'pdf', status: tile.status}) }}">
                                    <span class="accessibility-audit-assettile__num">{{ tile.n|number }}</span>
                                    <span class="accessibility-audit-assettile__label">{{ tile.label }}</span>
                                </a>
                            {% endfor %}
                        </div>
                    </div>
                {% endif %}
    {% endset %}
    {% set pdfsDone = pdfsClear and pdfTiles is not empty %}
    {% if assetStats %}
        {% set missingCount = assetStats.byRule['asset-alt-missing'] ?? 0 %}
        {% set filenameCount = assetStats.byRule['asset-alt-filename'] ?? 0 %}
        {% set shortCount = assetStats.byRule['asset-alt-short'] ?? 0 %}
        {% set draftCount = assetDraftCount ?? 0 %}
        {% set decorativeCount = assetDecorativeCount ?? 0 %}
        {% set imagesClear = assetStats.withIssues == 0 %}

        {% set imageTiles = [] %}
        {% if imagesClear %}
            {% set imageTiles = imageTiles|merge([{ n: max(assetStats.total - decorativeCount, 0), label: 'With alt text'|t('accessibility-audit'), tone: 'good', filter: null }]) %}
        {% endif %}
        {% if missingCount > 0 %}
            {% set imageTiles = imageTiles|merge([{ n: missingCount, label: 'Missing alt'|t('accessibility-audit'), tone: 'warning', filter: 'asset-alt-missing' }]) %}
        {% endif %}
        {% if filenameCount > 0 %}
            {% set imageTiles = imageTiles|merge([{ n: filenameCount, label: 'Filename as alt'|t('accessibility-audit'), tone: 'warning', filter: 'asset-alt-filename' }]) %}
        {% endif %}
        {% if shortCount > 0 %}
            {% set imageTiles = imageTiles|merge([{ n: shortCount, label: 'Very short alt'|t('accessibility-audit'), tone: 'notice', filter: 'asset-alt-short' }]) %}
        {% endif %}
        {% if draftCount > 0 %}
            {% set imageTiles = imageTiles|merge([{ n: draftCount, label: 'Drafts to review'|t('accessibility-audit'), tone: 'notice', filter: 'drafts' }]) %}
        {% endif %}
        {% if decorativeCount > 0 %}
            {% set imageTiles = imageTiles|merge([{ n: decorativeCount, label: 'Decorative'|t('accessibility-audit'), tone: 'neutral', filter: 'decorative' }]) %}
        {% endif %}


        <div class="pane accessibility-audit-assets-pane">
            <div class="accessibility-audit-pane-head">
                <div>
                    <h2 style="margin:0">{{ 'Assets'|t('accessibility-audit') }}</h2>
                    <p class="light" style="margin:2px 0 0">{{ 'Alt text and PDF checks across the asset library'|t('accessibility-audit') }}</p>
                </div>
                <div class="accessibility-audit-pane-head__action">
                    {% if assetDraftRunning ?? false %}
                        <span class="light">{{ 'Drafting alt text in the background.'|t('accessibility-audit') }}</span>
                    {% elseif draftCount > 0 %}
                        <a href="{{ cpUrl(assetsUrl, {filter: 'drafts'}) }}" class="go">{{ '{n, plural, =1{Review # draft} other{Review # drafts}}'|t('accessibility-audit', {n: draftCount}) }}</a>
                    {% elseif missingCount > 0 and (assetHasApiKey ?? false) %}
                        <a href="{{ cpUrl(assetsUrl, {filter: 'asset-alt-missing'}) }}" class="go">{{ 'Draft alt text'|t('accessibility-audit') }}</a>
                    {% elseif not imagesClear %}
                        <a href="{{ cpUrl(assetsUrl) }}" class="go">{{ 'Fix alt text'|t('accessibility-audit') }}</a>
                    {% elseif not pdfsClear %}
                        <a href="{{ cpUrl(assetsUrl, {filter: 'pdf', status: pdfStats.withIssues > 0 ? 'needs-fixing' : 'not-checked'}) }}" class="go">{{ 'Fix PDFs'|t('accessibility-audit') }}</a>
                    {% else %}
                        <a href="{{ cpUrl(assetsUrl) }}" class="go">{{ 'Open the Assets page'|t('accessibility-audit') }}</a>
                    {% endif %}
                </div>
            </div>

            <div class="accessibility-audit-assettiles">
                <div class="accessibility-audit-assettiles__group">
                    <h3 class="accessibility-audit-col-label">{{ 'Images'|t('accessibility-audit') }}</h3>
                    <div class="accessibility-audit-assettiles__row">
                        {% for tile in imageTiles %}
                            <a class="accessibility-audit-assettile accessibility-audit-assettile--{{ tile.tone }}" href="{{ cpUrl(assetsUrl, {filter: tile.filter}|filter) }}">
                                <span class="accessibility-audit-assettile__num">{{ tile.n|number }}</span>
                                <span class="accessibility-audit-assettile__label">{{ tile.label }}</span>
                            </a>
                        {% endfor %}
                    </div>
                </div>
                {{ pdfGroup }}
            </div>
            {% set imagesDone = imagesClear and assetStats.total > 0 %}
            {% if imagesDone or pdfsDone %}
                <p class="light accessibility-audit-emptyok accessibility-audit-assets-pane__clear">
                    <span class="accessibility-audit-resolved-check" data-icon="check" aria-hidden="true"></span>
                    {% if imagesDone and pdfsDone %}
                        {{ 'Every image has alt text or is marked decorative, and every PDF passed its checks.'|t('accessibility-audit') }}
                    {% elseif imagesDone %}
                        {{ 'Every image has alt text or is marked decorative.'|t('accessibility-audit') }}
                    {% else %}
                        {{ 'Every PDF passed its checks.'|t('accessibility-audit') }}
                    {% endif %}
                </p>
            {% endif %}
        </div>
    {% else %}
        <div class="accessibility-audit-panelnote accessibility-audit-panelnote--waiting">
            <div class="accessibility-audit-panelnote__text">
                <p class="accessibility-audit-panelnote__lead warning has-icon">
                    <span class="icon" aria-hidden="true"></span>
                    <span>{{ 'The asset library has not been audited yet.'|t('accessibility-audit') }}</span>
                </p>
                <p class="accessibility-audit-panelnote__body">
                    {{ 'Every image carries its own alt text and none of it has been through a scan, so the score above does not account for any of it.'|t('accessibility-audit') }}
                </p>
            </div>
            <a href="{{ cpUrl('accessibility-audit/assets') }}" class="go accessibility-audit-panelnote__action">{{ 'Run the first scan'|t('accessibility-audit') }}</a>
        </div>
        {% if pdfTiles is not empty %}
            <div class="pane accessibility-audit-assets-pane">
                <div class="accessibility-audit-pane-head">
                    <div>
                        <h2 style="margin:0">{{ 'Assets'|t('accessibility-audit') }}</h2>
                        <p class="light" style="margin:2px 0 0">{{ 'Alt text and PDF checks across the asset library'|t('accessibility-audit') }}</p>
                    </div>
                    <div class="accessibility-audit-pane-head__action">
                        {% if not pdfsClear %}
                            <a href="{{ cpUrl(assetsUrl, {filter: 'pdf', status: pdfStats.withIssues > 0 ? 'needs-fixing' : 'not-checked'}) }}" class="go">{{ 'Fix PDFs'|t('accessibility-audit') }}</a>
                        {% else %}
                            <a href="{{ cpUrl(assetsUrl) }}" class="go">{{ 'Open the Assets page'|t('accessibility-audit') }}</a>
                        {% endif %}
                    </div>
                </div>
                <div class="accessibility-audit-assettiles">
                    {{ pdfGroup }}
                </div>
                {% if pdfsDone %}
                    <p class="light accessibility-audit-emptyok accessibility-audit-assets-pane__clear">
                        <span class="accessibility-audit-resolved-check" data-icon="check" aria-hidden="true"></span>
                        {{ 'Every PDF passed its checks.'|t('accessibility-audit') }}
                    </p>
                {% endif %}
            </div>
        {% endif %}
    {% endif %}


    <div class="pane accessibility-audit-grouped-pane" style="position:relative">
        <h2 style="margin:0">
            {%- if byImpact|length == 1 -%}
                {{ 'Fix this rule to improve your score'|t('accessibility-audit') }}
            {%- elseif byImpact|length > 1 -%}
                {{ 'Fix these {n} rules to improve your score'|t('accessibility-audit', {n: byImpact|length}) }}
            {%- else -%}
                {{ 'Rules to fix'|t('accessibility-audit') }}
            {%- endif -%}
        </h2>
        <p class="light" style="margin:2px 0 12px">
            {% if byImpact|length == 0 %}
                {{ 'Nothing here at the moment.'|t('accessibility-audit') }}
            {% elseif byImpactAll|length > byImpact|length %}
                {{ 'Top rules by points to gain · '|t('accessibility-audit', {n: byImpact|length}) }}<a href="{{ cpUrl('accessibility-audit/issues', {site: siteHandle}) }}">{{ 'all {total} rules'|t('accessibility-audit', {total: byImpactAll|length}) }}</a>
            {% else %}
                {{ 'Grouped by severity · sorted by points to gain'|t('accessibility-audit') }}
            {% endif %}
        </p>
        {% if byImpact|length > 0 %}
        {% include 'accessibility-audit/_includes/grouped-issues' with { rows: byImpact, allRows: byImpactAll, siteHandle: siteHandle, filterCorner: true } only %}
        <p class="accessibility-audit-cta-right"><a class="go" href="{{ cpUrl('accessibility-audit/issues', {site: siteHandle}) }}">{{ 'View issues by page'|t('accessibility-audit') }}</a></p>
        {% else %}
            <p class="light accessibility-audit-emptyok">
                <span class="accessibility-audit-resolved-check" data-icon="check" aria-hidden="true"></span>
                {{ 'No issues found.'|t('accessibility-audit') }}
            </p>
        {% endif %}
    </div>

   
    <div class="pane accessibility-audit-grouped-pane">
        <h2 style="margin:0">{{ 'Template issues'|t('accessibility-audit') }}</h2>
        <p class="light" style="margin:2px 0 0">{{ 'Fix once, fix everywhere'|t('accessibility-audit') }}</p>
        {% if templateIssues|length > 0 %}
        {% set severityLabels = {
            error: 'Error'|t('accessibility-audit'),
            warning: 'Warning'|t('accessibility-audit'),
            notice: 'Notice'|t('accessibility-audit'),
        } %}

        <div class="accessibility-audit-table-scroll">
            <table class="data fullwidth" style="margin-top:12px">
            <thead>
                <tr>
                    <th scope="col">{{ 'Rule'|t('accessibility-audit') }}</th>
                    <th scope="col">{{ 'WCAG'|t('accessibility-audit') }}</th>
                    <th scope="col">{{ 'SC'|t('accessibility-audit') }}</th>
                    <th scope="col" class="rightalign">{{ 'Pages'|t('accessibility-audit') }}</th>
                    <th scope="col" class="rightalign">{{ 'Occurrences'|t('accessibility-audit') }}</th>
                </tr>
            </thead>
            <tbody>
                {% for row in templateIssues %}
                    <tr>
                        <th scope="row">
                            <span class="accessibility-audit-rowline" style="gap:8px">
                                <span class="accessibility-audit-legend__dot accessibility-audit-legend__dot--{{ row.severity }}" role="img" aria-label="{{ severityLabels[row.severity] ?? row.severity }}"></span>
                                <span>{{ macros.ruleName(row.title, row.ruleId, url('accessibility-audit/issues/detail', {ruleId: row.ruleId, site: siteHandle})) }}</span>
                            </span>
                        </th>
                        <td>{{ macros.conformanceBadge(row.wcagLevel ?? null) }}</td>
                        <td class="code">{{ row.wcagCriterion ?? '—' }}</td>
                        <td class="rightalign">{{ row.pageCount }}</td>
                        <td class="rightalign">{{ row.occurrences }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
        </div>
        <p class="light">{{ 'These rules appear on 5+ pages, so the cause is likely in a template or layout.'|t('accessibility-audit') }}</p>
        {{ macros.conformanceLegend() }}
        {% else %}
            <p class="light accessibility-audit-emptyok">
                <span class="accessibility-audit-resolved-check" data-icon="check" aria-hidden="true"></span>
                {{ 'No template-level issues detected.'|t('accessibility-audit') }}
            </p>
        {% endif %}
    </div>


    {% if scoreHistory|length > 1 %}
        {% set firstDay = scoreHistory|first %}
        {% set lastDay = scoreHistory|last %}
        {% set scoreDelta = (lastDay.avgScore - firstDay.avgScore)|round %}
        <div class="pane accessibility-audit-score-history">
            <h2 style="margin:0">{{ 'Score history'|t('accessibility-audit') }}</h2>
            <p class="accessibility-audit-score-history__delta">
                {%- if scoreDelta > 0 -%}
                    <strong class="accessibility-audit-score-history__delta-value accessibility-audit-score-history__delta-value--up">{{ 'Up {n, plural, =1{# point} other{# points}}'|t('accessibility-audit', { n: scoreDelta }) }}</strong>
                {%- elseif scoreDelta < 0 -%}
                    <strong class="accessibility-audit-score-history__delta-value accessibility-audit-score-history__delta-value--down">{{ 'Down {n, plural, =1{# point} other{# points}}'|t('accessibility-audit', { n: scoreDelta|abs }) }}</strong>
                {%- else -%}
                    <strong class="accessibility-audit-score-history__delta-value">{{ 'No change'|t('accessibility-audit') }}</strong>
                {%- endif %}
                {{ 'since {date}'|t('accessibility-audit', { date: firstDay.day|date('j F') }) }}
            </p>
            <ul class="accessibility-audit-score-history__legend">
                <li><span class="accessibility-audit-score-history__key accessibility-audit-score-history__key--overall" aria-hidden="true"></span>{{ 'Overall'|t('accessibility-audit') }}</li>
                <li><span class="accessibility-audit-score-history__key accessibility-audit-score-history__key--aa" aria-hidden="true"></span>{{ 'Level AA'|t('accessibility-audit') }}</li>
                <li><span class="accessibility-audit-score-history__key accessibility-audit-score-history__key--a" aria-hidden="true"></span>{{ 'Level A'|t('accessibility-audit') }}</li>
            </ul>
            <div id="accessibility-audit-score-history-chart" style="margin-top:10px"></div>

            {% js %}
            (() => {
                const history = {{ scoreHistory|json_encode|raw }};
                const target = {{ targetScore }};
                const chartEl = document.getElementById('accessibility-audit-score-history-chart');
                if (!chartEl || !history || history.length < 2) { return; }

                const H = 200;
                const padL = 34, padR = 16, padT = 12;
                const n = history.length;
                const fmtDate = (s) => { const p = String(s).split('-'); return p[2] + '/' + p[1]; };

              
                let tbl = '<table class="visually-hidden"><caption>'
                    + Craft.t('accessibility-audit', 'Accessibility score by date') + '</caption><thead><tr><th scope="col">'
                    + Craft.t('accessibility-audit', 'Date') + '</th><th scope="col">'
                    + Craft.t('accessibility-audit', 'Score') + '</th><th scope="col">'
                    + Craft.t('accessibility-audit', 'Level AA') + '</th><th scope="col">'
                    + Craft.t('accessibility-audit', 'Level A') + '</th></tr></thead><tbody>';
                history.forEach((d) => {
                    tbl += '<tr><td>' + Craft.escapeHtml(String(d.day)) + '</td><td>'
                        + (Number(d.avgScore) || 0) + '</td><td>'
                        + (Number(d.avgScoreAA) || 0) + '</td><td>'
                        + (Number(d.avgScoreA) || 0) + '</td></tr>';
                });
                tbl += '</tbody></table>';

                
                const draw = () => {
                    const W = Math.max(320, Math.round(chartEl.clientWidth) || 760);
                    const plotW = W - padL - padR, plotH = H - padT - 26;

                    const x = (i) => padL + (n === 1 ? plotW / 2 : (i / (n - 1)) * plotW);
                    const y = (v) => padT + plotH - (Math.max(0, Math.min(100, v)) / 100) * plotH;
                    const series = (key) => history.map((d, i) => x(i) + ',' + y(Number(d[key]) || 0)).join(' ');
                    const pts = series('avgScore');

                    const svg = ['<svg viewBox="0 0 ' + W + ' ' + H + '" width="100%" height="' + H + '" preserveAspectRatio="xMidYMid meet" role="img" aria-label="' + Craft.t('accessibility-audit', 'Accessibility score over time') + '">'];
                    for (let g = 0; g <= 4; g++) {
                        const gy = padT + (g / 4) * plotH;
                        svg.push('<line x1="' + padL + '" y1="' + gy + '" x2="' + (W - padR) + '" y2="' + gy + '" stroke="var(--border-hairline)" stroke-width="1"/>');
                        svg.push('<text x="' + (padL - 6) + '" y="' + (gy + 3) + '" text-anchor="end" font-size="9" fill="var(--medium-text-color)">' + Math.round(100 * (1 - g / 4)) + '</text>');
                    }
                    [0, Math.floor((n - 1) / 2), n - 1].forEach((i) => {
                        svg.push('<text x="' + x(i) + '" y="' + (H - 8) + '" text-anchor="middle" font-size="9" fill="var(--medium-text-color)">' + fmtDate(history[i].day) + '</text>');
                    });
                    if (target > 0) {
                        const ty = y(target);
                        svg.push('<line x1="' + padL + '" y1="' + ty + '" x2="' + (W - padR) + '" y2="' + ty + '" stroke="var(--aa-pass)" stroke-width="1.5" stroke-dasharray="4 3" opacity="0.75"/>');
                        svg.push('<text x="' + (W - padR) + '" y="' + (ty - 4) + '" text-anchor="end" font-size="9" fill="var(--aa-pass)">' + Craft.t('accessibility-audit', 'Target {n}', { n: target }) + '</text>');
                    }
                    const areaPts = padL + ',' + (padT + plotH) + ' ' + pts + ' ' + (W - padR) + ',' + (padT + plotH);

                    svg.push('<polygon points="' + areaPts + '" fill="var(--link-color)" opacity="0.05"/>');

                    if (target > 0) {
                        const ty = y(target);
                        const bandPts = padL + ',' + ty + ' ' + pts + ' ' + (W - padR) + ',' + ty;
                        svg.push('<defs>'
                            + '<clipPath id="aa-sh-above"><rect x="' + padL + '" y="' + padT + '" width="' + plotW + '" height="' + Math.max(0, ty - padT) + '"/></clipPath>'
                            + '<clipPath id="aa-sh-below"><rect x="' + padL + '" y="' + ty + '" width="' + plotW + '" height="' + Math.max(0, padT + plotH - ty) + '"/></clipPath>'
                            + '</defs>');
                        svg.push('<polygon points="' + bandPts + '" fill="var(--aa-pass)" opacity="0.22" clip-path="url(#aa-sh-above)"/>');
                        svg.push('<polygon points="' + bandPts + '" fill="var(--aa-warning-marker)" opacity="0.22" clip-path="url(#aa-sh-below)"/>');
                    }

                    svg.push('<polyline points="' + series('avgScoreA') + '" fill="none" stroke="var(--aa-series-a)" stroke-width="1.25" stroke-dasharray="3 3"/>');
                    svg.push('<polyline points="' + series('avgScoreAA') + '" fill="none" stroke="var(--aa-series-aa)" stroke-width="1.25" opacity="0.7"/>');
                    svg.push('<polyline points="' + pts + '" fill="none" stroke="var(--link-color)" stroke-width="2"/>');
                    history.forEach((d, i) => {
                        svg.push('<circle cx="' + x(i) + '" cy="' + y(Number(d.avgScore) || 0) + '" r="2.5" fill="var(--link-color)"/>');
                    });
                    svg.push('</svg>');

                    chartEl.innerHTML = svg.join('') + tbl;
                };

               
                let queued = false;
                const ro = new ResizeObserver(() => {
                    if (queued) { return; }
                    queued = true;
                    requestAnimationFrame(() => { queued = false; draw(); });
                });
                ro.observe(chartEl);
            })();
            {% endjs %}
        </div>
    {% endif %}


{% if resolvedIssues|length > 0 %}
<div class="pane accessibility-audit-grouped-pane">
    <div style="display:flex;align-items:flex-start;gap:10px">
        <div>
            <h2 style="margin:0">{{ 'Resolved issues'|t('accessibility-audit') }}</h2>
            <p class="light" style="margin:2px 0 0">{{ 'Issues fixed since the last scan'|t('accessibility-audit') }}</p>
        </div>
        <a href="{{ cpUrl('accessibility-audit/issues', {site: siteHandle, tab: 'resolved'}) }}" class="go" style="margin-left:auto">{{ 'View all resolved'|t('accessibility-audit') }}</a>
    </div>
    <div class="accessibility-audit-table-scroll">
        <table class="data fullwidth" style="margin-top:12px">
        <thead>
            <tr>
                <th scope="col">{{ 'Rule'|t('accessibility-audit') }}</th>
                <th scope="col">{{ 'SC'|t('accessibility-audit') }}</th>
                <th scope="col">{{ 'Resolved'|t('accessibility-audit') }}</th>
                <th scope="col" class="rightalign">{{ 'Occurrences'|t('accessibility-audit') }}</th>
            </tr>
        </thead>
        <tbody>
            {% for row in resolvedIssues %}
                <tr>
                    <th scope="row">
                        <span class="accessibility-audit-rowline" style="gap:8px">
                            <span class="accessibility-audit-resolved-check" data-icon="check" aria-hidden="true"></span>
                            <span class="visually-hidden">{{ 'Resolved'|t('accessibility-audit') }}:</span>
                            <span>{{ macros.ruleName(row.title, row.ruleId) }}</span>
                        </span>
                    </th>
                    <td class="code">{{ row.wcagCriterion ?? '—' }}</td>
                    <td class="light">{{ row.dateResolved ? row.dateResolved|date('d M Y') : '—' }}</td>
                    <td class="rightalign">{{ row.count }}</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
    </div>
</div>
{% endif %}

</div>
{% endif %}
{% endblock %}
