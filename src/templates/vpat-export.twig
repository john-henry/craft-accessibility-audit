<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>VPAT{% if report.meta.productName ?? false %}: {{ report.meta.productName }}{% endif %}</title>
<style>
/* ── Base ─────────────────────────────────────────────────────────────────── */
*, *::before, *::after { box-sizing: border-box; }
body {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;
    font-size: 13px;
    line-height: 1.5;
    color: #222;
    background: #fff;
    margin: 0;
    padding: 0;
}
a { color: #0d78f2; }
a:hover { text-decoration: underline; }

/* ── Print ───────────────────────────────────────────────────────────────── */
@page { margin: 16mm 14mm; }

@media print {
    body { font-size: 11px; }
    .vpat-print-bar { display: none !important; }

    /* A conformance table runs to fifty rows and will never fit a page, so it
       breaks across them and repeats its header. Keeping the whole table
       together pushes it to a fresh page and leaves the rest of the one before
       it empty. Rows are what must stay intact. */
    thead { display: table-header-group; }
    tr { break-inside: avoid; page-break-inside: avoid; }
    h1, h2, h3 { break-after: avoid; page-break-after: avoid; }
    .vpat-section { break-inside: auto; page-break-inside: auto; }
}

/* ── Layout ──────────────────────────────────────────────────────────────── */
.vpat-print-bar {
    background: #1b3a6b;
    color: #fff;
    padding: 10px 40px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 12px;
    position: sticky;
    top: 0;
    z-index: 10;
}
.vpat-print-bar a { color: #7eb8f7; }
.vpat-print-bar__actions { display: flex; gap: 12px; align-items: center; }
.vpat-print-bar__status { font-size: 11px; color: #cfe2f8; max-width: 320px; }
.vpat-print-bar button[disabled] { opacity: 0.55; cursor: default; }
.vpat-print-bar button {
    background: #fff;
    color: #1b3a6b;
    border: 0;
    padding: 6px 16px;
    border-radius: 4px;
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
}

.vpat-doc {
    max-width: 1000px;
    margin: 0 auto;
    padding: 40px 40px 80px;
}

/* ── Header ──────────────────────────────────────────────────────────────── */
.vpat-header {
    border-bottom: 3px solid #1b3a6b;
    padding-bottom: 20px;
    margin-bottom: 30px;
}
.vpat-header h1 {
    font-size: 24px;
    font-weight: 700;
    color: #1b3a6b;
    margin: 0 0 4px;
}
.vpat-header .vpat-subtitle {
    font-size: 13px;
    color: #555;
    margin: 0;
}

/* ── Section headings ────────────────────────────────────────────────────── */
.vpat-section { margin-bottom: 30px; }
.vpat-section h2 {
    font-size: 16px;
    font-weight: 700;
    color: #1b3a6b;
    border-bottom: 1px solid #c8d4e8;
    padding-bottom: 6px;
    margin: 0 0 14px;
}
.vpat-section h3 {
    font-size: 14px;
    font-weight: 600;
    margin: 20px 0 10px;
}

/* ── Info table (product metadata) ──────────────────────────────────────── */
.vpat-info-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
}
.vpat-info-table td,
.vpat-info-table th {
    padding: 5px 10px 5px 0;
    vertical-align: top;
}
.vpat-info-table th {
    font-weight: 600;
    white-space: nowrap;
    width: 200px;
    color: #555;
    text-align: left;
}

/* ── Conformance tables ──────────────────────────────────────────────────── */
.vpat-criteria-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 12px;
    margin-bottom: 30px;
}
.vpat-criteria-table th {
    background: #1b3a6b;
    color: #fff;
    padding: 8px 10px;
    text-align: left;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.03em;
}
.vpat-criteria-table td {
    padding: 8px 10px;
    border: 1px solid #d6dde8;
    vertical-align: top;
}
.vpat-criteria-table tr:nth-child(even) td { background: #f5f8fc; }

/* Widths hang off classes rather than column position: the EN 301 549 column
   appears only on reports that claim the standard, and counting from the left
   would resize the wrong columns on the reports that do. */
.vpat-col-crit { width: 100px; }
.vpat-col-en { width: 90px; white-space: nowrap; }
.vpat-col-level { width: 175px; }
.vpat-col-remarks { width: auto; }

.vpat-en-none {
    color: #777;
    font-style: italic;
    white-space: normal;
}

.vpat-crit-num {
    font-weight: 700;
    white-space: nowrap;
}
.vpat-crit-num a {
    color: inherit;
    text-decoration: none;
}
.vpat-crit-num a:hover { text-decoration: underline; }

/* ── Conformance badges ──────────────────────────────────────────────────── */
.vpat-badge {
    display: inline-block;
    padding: 2px 8px;
    border-radius: 10px;
    font-size: 11px;
    font-weight: 600;
    white-space: nowrap;
}
.vpat-badge--supports       { background: #d4f4df; color: #1b6b35; }
.vpat-badge--partial        { background: #fef3cd; color: #7a5200; }
.vpat-badge--fail           { background: #fde8e8; color: #9b1c1c; }
.vpat-badge--na             { background: #ebebeb; color: #555; }
.vpat-badge--not-evaluated  { background: #ede9fe; color: #5b21b6; }
.vpat-badge--empty          { color: #aaa; font-weight: 400; font-style: italic; font-size: 11px; }

/* ── Scope & methods lists ───────────────────────────────────────────────── */
.vpat-scope-list,
.vpat-methods-list {
    margin: 6px 0 0;
    padding-left: 20px;
    columns: 2;
    column-gap: 40px;
}
.vpat-scope-list li,
.vpat-methods-list li {
    margin-bottom: 3px;
    break-inside: avoid;
}

/* ── Terms legend ────────────────────────────────────────────────────────── */
.vpat-terms dl {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 6px 20px;
    font-size: 12px;
}
.vpat-terms dt { font-weight: 600; }
.vpat-terms dd { margin: 0; }

/* ── Footer ──────────────────────────────────────────────────────────────── */
.vpat-footer {
    margin-top: 50px;
    padding-top: 16px;
    border-top: 1px solid #d6dde8;
    font-size: 11px;
    color: #999;
}
</style>
</head>
<body>

{% set jsonFlags = constant('JSON_HEX_TAG') b-or constant('JSON_HEX_APOS') b-or constant('JSON_HEX_QUOT') b-or constant('JSON_HEX_AMP') %}

{% set levelLabels = {
    'Supports': 'Supports'|t('accessibility-audit'),
    'Partially Supports': 'Partially Supports'|t('accessibility-audit'),
    'Does Not Support': 'Does Not Support'|t('accessibility-audit'),
    'Not Applicable': 'Not Applicable'|t('accessibility-audit'),
    'Not Evaluated': 'Not Evaluated'|t('accessibility-audit'),
    'Not evaluated': 'Not evaluated'|t('accessibility-audit'),
} %}

<div id="vpat-print-bar-mount"></div>
<script>
(function() {
    'use strict';

    // Built here rather than sitting in the markup so it exists only in a
    // browser. Saving this page, or running it through an HTML to PDF
    // converter, leaves a document with no editor controls in it, whether or
    // not that converter honours the print stylesheet.
    var mount = document.getElementById('vpat-print-bar-mount');
    if (!mount) { return; }

    var bar = document.createElement('div');
    bar.className = 'vpat-print-bar';

    var label = document.createElement('span');
    label.textContent = {{ 'VPAT®: WCAG 2.2 Level AA Conformance Report'|t('accessibility-audit')|json_encode(jsonFlags)|raw }};

    var actions = document.createElement('div');
    actions.className = 'vpat-print-bar__actions';

    var back = document.createElement('button');
    back.type = 'button';
    var arrow = document.createElement('span');
    arrow.setAttribute('aria-hidden', 'true');
    arrow.textContent = '← ';
    back.appendChild(arrow);
    back.appendChild(document.createTextNode(
        {{ 'Back to editor'|t('accessibility-audit')|json_encode(jsonFlags)|raw }}
    ));
    back.addEventListener('click', function() { window.close(); });

    var print = document.createElement('button');
    print.type = 'button';
    print.textContent = {{ 'Print / Save as PDF'|t('accessibility-audit')|json_encode(jsonFlags)|raw }};
    print.addEventListener('click', function() { window.print(); });

    actions.appendChild(back);

    {% if currentUser.can('accessibility-audit:manageVpat') %}
        // Recording is deliberate: opening this document is a preview, and only
        // the author knows when a version of it was actually issued to somebody.
        var record = document.createElement('button');
        record.type = 'button';
        record.textContent = {{ 'Record this revision'|t('accessibility-audit')|json_encode(jsonFlags)|raw }};

        var status = document.createElement('span');
        status.className = 'vpat-print-bar__status';
        status.setAttribute('role', 'status');

        record.addEventListener('click', function() {
            record.disabled = true;
            status.textContent = {{ 'Recording…'|t('accessibility-audit')|json_encode(jsonFlags)|raw }};

            // The token is asked for now rather than printed into the page.
            // This document is meant to be saved and sent to somebody, and a
            // CSRF token baked into the file would travel with it.
            fetch({{ actionUrl('users/session-info')|json_encode(jsonFlags)|raw }}, {
                headers: { 'Accept': 'application/json' },
            })
                .then(function(res) { return res.json(); })
                .then(function(session) {
                    var body = new FormData();
                    body.append('siteId', {{ report.siteId|json_encode(jsonFlags)|raw }});
                    body.append(session.csrfTokenName, session.csrfTokenValue);

                    return fetch({{ actionUrl('accessibility-audit/vpat/record-revision')|json_encode(jsonFlags)|raw }}, {
                        method: 'POST',
                        headers: { 'Accept': 'application/json' },
                        body: body,
                    });
                })
                .then(function(res) { return res.json(); })
                .then(function(data) {
                    status.textContent = data.message || '';
                    record.disabled = !!data.success;
                })
                .catch(function() {
                    status.textContent = {{ 'That could not be recorded. Try again.'|t('accessibility-audit')|json_encode(jsonFlags)|raw }};
                    record.disabled = false;
                });
        });

        actions.appendChild(status);
        actions.appendChild(record);
    {% endif %}

    actions.appendChild(print);
    bar.appendChild(label);
    bar.appendChild(actions);
    mount.parentNode.replaceChild(bar, mount);
})();
</script>

<div class="vpat-doc">

    <div class="vpat-header">
        <h1>{{ 'Accessibility Conformance Report'|t('accessibility-audit') }}</h1>
        <p class="vpat-subtitle">
            {{ 'WCAG Edition'|t('accessibility-audit') }} &nbsp;·&nbsp;
            {{ 'Based on VPAT® Version {version}'|t('accessibility-audit', { version: '2.5Rev' }) }}
        </p>
    </div>

    <div class="vpat-section">
        <h2>{{ 'Name of Product / Version'|t('accessibility-audit') }}</h2>
        <p>
            <strong>{{ report.meta.productName ?? '[Product Name]'|t('accessibility-audit') }}</strong>
            {% if report.meta.productVersion ?? false %}
                &nbsp;&nbsp;{{ 'Version {version}'|t('accessibility-audit', { version: report.meta.productVersion }) }}
            {% endif %}
        </p>

        {% if report.meta.productDescription ?? false %}
            <h2>{{ 'Product Description'|t('accessibility-audit') }}</h2>
            <p>{{ report.meta.productDescription|nl2br }}</p>
        {% endif %}

        <h2>{{ 'Report Date'|t('accessibility-audit') }}</h2>
        <table class="vpat-info-table">
            <tr>
                <th scope="row">{{ 'Report Date'|t('accessibility-audit') }}:</th>
                <td>{{ report.meta.reportDate ?? '[Not specified]'|t('accessibility-audit') }}</td>
            </tr>
            <tr>
                <th scope="row">{{ 'Evaluation Period'|t('accessibility-audit') }}:</th>
                <td>
                    {% if (report.meta.reportPeriodFrom ?? false) or (report.meta.reportPeriodTo ?? false) %}
                        {{ '{from} to {to}'|t('accessibility-audit', {
                            from: report.meta.reportPeriodFrom ?? '—',
                            to: report.meta.reportPeriodTo ?? '—',
                        }) }}
                    {% else %}
                        {{ '[Not specified]'|t('accessibility-audit') }}
                    {% endif %}
                </td>
            </tr>
            <tr>
                <th scope="row">{{ 'Contact'|t('accessibility-audit') }}:</th>
                <td>
                    {{ report.meta.contactName ?? '' }}
                    {% if report.meta.contactEmail ?? false %}
                        &lt;<a href="mailto:{{ report.meta.contactEmail }}">{{ report.meta.contactEmail }}</a>&gt;
                    {% endif %}
                    {% if report.meta.contactPhone ?? false %}
                        &nbsp;&nbsp;{{ report.meta.contactPhone }}
                    {% endif %}
                </td>
            </tr>
        </table>
    </div>

    {% if report.meta.notes ?? false %}
        <div class="vpat-section">
            <h2>{{ 'Notes'|t('accessibility-audit') }}</h2>
            <p>{{ report.meta.notes|nl2br }}</p>
        </div>
    {% endif %}

    {% if (report.meta.scopePages ?? []) is not empty %}
        <div class="vpat-section">
            <h2>{{ 'Scope of Evaluation'|t('accessibility-audit') }}</h2>
            <p>{{ 'The evaluation covered the following pages and screens:'|t('accessibility-audit') }}</p>
            <ul class="vpat-scope-list">
                {% for page in report.meta.scopePages %}
                    <li>{{ page }}</li>
                {% endfor %}
            </ul>
        </div>
    {% endif %}

    <div class="vpat-section">
        <h2>{{ 'Evaluation Methods Used'|t('accessibility-audit') }}</h2>
        {% if (report.meta.evalMethods ?? []) is not empty %}
            <ul class="vpat-methods-list">
                {% for method in report.meta.evalMethods %}
                    <li>{{ method }}</li>
                {% endfor %}
            </ul>
        {% endif %}
        {% if report.meta.evalMethodology ?? false %}
            <p>{{ report.meta.evalMethodology|nl2br }}</p>
        {% elseif (report.meta.evalMethods ?? []) is empty %}
            <p>{{ 'Automated scanning with axe-core and server-side HTML analysis.'|t('accessibility-audit') }}</p>
        {% endif %}
    </div>

    <div class="vpat-section">
        <h2>{{ 'Applicable Standards / Guidelines'|t('accessibility-audit') }}</h2>
        <p>
            {{ 'This report covers conformance with the following accessibility standard: <strong>Web Content Accessibility Guidelines (WCAG) 2.2</strong> at Level AA, published by the W3C World Wide Web Consortium at <a href="{url}">{url}</a>.'|t('accessibility-audit', {
                url: 'https://www.w3.org/TR/WCAG22/',
            })|raw }}
        </p>
        {% if report.en301549 ?? false %}
        <p>
            {{ '<strong>EN 301 549 {version}</strong> (the European standard behind the EU Web Accessibility Directive and the European Accessibility Act) adopts the WCAG Level AA success criteria for web content in its clause 9, so the results below speak to that clause. The corresponding clause number is given beside each criterion. Clauses covering non-web ICT, such as hardware, software, documents and support services, are outside the scope of this report.'|t('accessibility-audit', {
                version: report.en301549Version|e,
            })|raw }}
        </p>
        <p>
            {{ 'EN 301 549 {version} adopts WCAG 2.1. The criteria WCAG 2.2 added have no clause in it and are marked as such rather than given a clause number that does not exist in the standard. They are assessed here against WCAG 2.2 all the same.'|t('accessibility-audit', {
                version: report.en301549Version,
            }) }}
        </p>
        {% endif %}
    </div>

    <div class="vpat-section vpat-terms">
        <h2>{{ 'Terms Used in the Conformance Level Column'|t('accessibility-audit') }}</h2>
        <dl>
            <dt>{{ levelLabels['Supports'] }}</dt>
            <dd>{{ 'The functionality of the product meets the criterion without exception.'|t('accessibility-audit') }}</dd>
            <dt>{{ levelLabels['Partially Supports'] }}</dt>
            <dd>{{ 'Some functionality of the product meets the criterion, while other functionality does not.'|t('accessibility-audit') }}</dd>
            <dt>{{ levelLabels['Does Not Support'] }}</dt>
            <dd>{{ 'The majority of product functionality does not meet the criterion.'|t('accessibility-audit') }}</dd>
            <dt>{{ levelLabels['Not Applicable'] }}</dt>
            <dd>{{ 'The criterion is not relevant to this product.'|t('accessibility-audit') }}</dd>
            <dt>{{ levelLabels['Not Evaluated'] }}</dt>
            <dd>{{ 'The product has not been evaluated against this criterion. (Allowed for Level AAA only.)'|t('accessibility-audit') }}</dd>
        </dl>
    </div>

    <div class="vpat-section">
        <h2>{{ 'WCAG 2.2 Report'|t('accessibility-audit') }}</h2>
        <p>
            {{ 'Note: When reporting on conformance with the WCAG 2.x Success Criteria, they are scoped for full pages, complete processes, and accessibility-supported ways.'|t('accessibility-audit') }}
        </p>

        <h3>{{ 'Table 1: Success Criteria, Level A'|t('accessibility-audit') }}</h3>
        <table class="vpat-criteria-table">
            <thead>
                <tr>
                    <th scope="col" class="vpat-col-crit">{{ 'Criteria'|t('accessibility-audit') }}</th>
                    {% if report.en301549 %}
                        <th scope="col" class="vpat-col-en">EN 301 549</th>
                    {% endif %}
                    <th scope="col" class="vpat-col-level">{{ 'Conformance Level'|t('accessibility-audit') }}</th>
                    <th scope="col" class="vpat-col-remarks">{{ 'Remarks and Explanations'|t('accessibility-audit') }}</th>
                </tr>
            </thead>
            <tbody>
                {% for num, row in report.levelA %}
                    <tr>
                        <td class="vpat-crit-num vpat-col-crit">
                            <a href="{{ row.url }}" target="_blank" rel="noopener">{{ num }}</a>
                            {{ row.name }}
                        </td>
                        {% if report.en301549 %}
                            <td class="vpat-col-en">
                                {%- if row.enClause -%}
                                    {{ row.enClause }}
                                {%- else -%}
                                    <span class="vpat-en-none">{{ 'Not in {version}'|t('accessibility-audit', { version: report.en301549Version }) }}</span>
                                {%- endif -%}
                            </td>
                        {% endif %}
                        <td class="vpat-col-level">
                            {% if row.effectiveLevel %}
                                {% set badgeClass = {
                                    'Supports':          'supports',
                                    'Partially Supports':'partial',
                                    'Does Not Support':  'fail',
                                    'Not Applicable':    'na',
                                    'Not Evaluated':     'not-evaluated',
                                }[row.effectiveLevel] ?? 'na' %}
                                <span class="vpat-badge vpat-badge--{{ badgeClass }}">{{ levelLabels[row.effectiveLevel] ?? row.effectiveLevel }}</span>
                            {% else %}
                                <span class="vpat-badge vpat-badge--empty">{{ levelLabels['Not evaluated'] }}</span>
                            {% endif %}
                        </td>
                        <td class="vpat-col-remarks">{{ row.effectiveRemarks|nl2br ?: '' }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>

        <h3>{{ 'Table 2: Success Criteria, Level AA'|t('accessibility-audit') }}</h3>
        <table class="vpat-criteria-table">
            <thead>
                <tr>
                    <th scope="col" class="vpat-col-crit">{{ 'Criteria'|t('accessibility-audit') }}</th>
                    {% if report.en301549 %}
                        <th scope="col" class="vpat-col-en">EN 301 549</th>
                    {% endif %}
                    <th scope="col" class="vpat-col-level">{{ 'Conformance Level'|t('accessibility-audit') }}</th>
                    <th scope="col" class="vpat-col-remarks">{{ 'Remarks and Explanations'|t('accessibility-audit') }}</th>
                </tr>
            </thead>
            <tbody>
                {% for num, row in report.levelAA %}
                    <tr>
                        <td class="vpat-crit-num vpat-col-crit">
                            <a href="{{ row.url }}" target="_blank" rel="noopener">{{ num }}</a>
                            {{ row.name }}
                        </td>
                        {% if report.en301549 %}
                            <td class="vpat-col-en">
                                {%- if row.enClause -%}
                                    {{ row.enClause }}
                                {%- else -%}
                                    <span class="vpat-en-none">{{ 'Not in {version}'|t('accessibility-audit', { version: report.en301549Version }) }}</span>
                                {%- endif -%}
                            </td>
                        {% endif %}
                        <td class="vpat-col-level">
                            {% if row.effectiveLevel %}
                                {% set badgeClass = {
                                    'Supports':          'supports',
                                    'Partially Supports':'partial',
                                    'Does Not Support':  'fail',
                                    'Not Applicable':    'na',
                                    'Not Evaluated':     'not-evaluated',
                                }[row.effectiveLevel] ?? 'na' %}
                                <span class="vpat-badge vpat-badge--{{ badgeClass }}">{{ levelLabels[row.effectiveLevel] ?? row.effectiveLevel }}</span>
                            {% else %}
                                <span class="vpat-badge vpat-badge--empty">{{ levelLabels['Not evaluated'] }}</span>
                            {% endif %}
                        </td>
                        <td class="vpat-col-remarks">{{ row.effectiveRemarks|nl2br ?: '' }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    {% if report.revisions|length %}
        <div class="vpat-section">
            <h2>{{ 'Revision History'|t('accessibility-audit') }}</h2>
            <p>
                {{ 'What changed between this revision of the report and the ones recorded before it. A criterion is listed where its conformance level moved; wording changes are counted rather than listed. Each revision is recorded deliberately, so this is a history of the versions that were put out, not a log of every edit made along the way.'|t('accessibility-audit') }}
            </p>
            {% for revision in report.revisions %}
                <h3>{{ revision.date|date('long') }}</h3>
                {% if revision.changes|length %}
                    <table class="vpat-criteria-table vpat-revision-table">
                        <thead>
                            <tr>
                                <th scope="col" class="vpat-col-crit">{{ 'Criteria'|t('accessibility-audit') }}</th>
                                <th scope="col" class="vpat-col-level">{{ 'Was'|t('accessibility-audit') }}</th>
                                <th scope="col" class="vpat-col-level">{{ 'Became'|t('accessibility-audit') }}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for change in revision.changes %}
                                <tr>
                                    <td class="vpat-crit-num vpat-col-crit">
                                        {{ change.criterion }} {{ change.name }}
                                    </td>
                                    <td class="vpat-col-level">{{ levelLabels[change.from] ?? change.from }}</td>
                                    <td class="vpat-col-level">{{ levelLabels[change.to] ?? change.to }}</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                {% else %}
                    <p>{{ 'No conformance level changed.'|t('accessibility-audit') }}</p>
                {% endif %}
                {% if revision.remarkEdits %}
                    <p>
                        {{ '{n, plural, =1{# remark was reworded without the conformance level changing.} other{# remarks were reworded without the conformance level changing.}}'|t('accessibility-audit', { n: revision.remarkEdits }) }}
                    </p>
                {% endif %}
            {% endfor %}
        </div>
    {% endif %}

    {% if report.meta.legalDisclaimer ?? false %}
        <div class="vpat-section">
            <h2>{{ 'Legal Disclaimer'|t('accessibility-audit') }}</h2>
            <p>{{ report.meta.legalDisclaimer|nl2br }}</p>
        </div>
    {% endif %}

    <div class="vpat-footer">
        <p>
            {{ 'VPAT® is a registered service mark of the Information Technology Industry Council (ITI).'|t('accessibility-audit') }}
            {{ 'This report was generated using the Accessibility Audit plugin for Craft CMS.'|t('accessibility-audit') }}
            {{ 'Generated: {date}.'|t('accessibility-audit', { date: now|date('Y-m-d') }) }}
        </p>
    </div>

</div>
</body>
</html>
