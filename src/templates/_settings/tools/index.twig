{% extends "accessibility-audit/_settings/layout" %}

{% import "_includes/forms" as forms %}
{% import 'accessibility-audit/_macros' as macros %}


{% set crumbs = [] %}

{% set fullPageForm = not (readOnly ?? false) %}

{% block blockContent %}
    {% if readOnly %}<fieldset class="accessibility-audit-readonly" disabled>{% endif %}
  

    {{ actionInput('accessibility-audit/settings/save-tools') }}
    {{ redirectInput(url('accessibility-audit/settings/tools')) }}

    <h2>{{ 'Alt Text'|t('accessibility-audit') }}</h2>
    
    {% set assetFieldOptions = [{ value: 'alt', label: 'alt (Craft built-in)' }] %}
    {% for field in craft.app.fields.allFields %}
        {% if field.className in [
            'craft\\fields\\PlainText',
            'craft\\fields\\Textarea',
            'craft\\ckeditor\\Field',
            'craft\\redactor\\Field',
        ] %}
            {% set assetFieldOptions = assetFieldOptions|merge([{ value: field.handle, label: field.name ~ ' (' ~ field.handle ~ ')' }]) %}
        {% endif %}
    {% endfor %}

    {{ forms.selectField({
        label: 'Alt Text Field'|t('accessibility-audit'),
        instructions: 'The field handle used to store alt text on assets. Defaults to Craft\'s built-in "alt" field. Change this if your assets use a custom plain text field for alt text. The asset audit and AI generation both read and write this field.'|t('accessibility-audit'),
        id: 'altTextField',
        name: 'settings[altTextField]',
        warning: config.altTextField is defined ? 'Overridden by config file.'|t('accessibility-audit'),
        disabled: config.altTextField is defined,
        options: assetFieldOptions,
        value: settings.altTextField,
        errors: settings.getErrors('altTextField'),
    }) }}
    
    

    {% if isPlus ?? false %}
    {{ forms.autosuggestField({
        label: 'Anthropic API Key'|t('accessibility-audit'),
        instructions: 'Used to generate alt text suggestions with Claude (Haiku). Get a key at platform.claude.com. You can also reference an environment variable: type $ to see suggestions.'|t('accessibility-audit'),
        id: 'anthropicApiKey',
        name: 'settings[anthropicApiKey]',
        warning: config.anthropicApiKey is defined ? 'Overridden by config file.'|t('accessibility-audit'),
        disabled: config.anthropicApiKey is defined,
        value: settings.anthropicApiKey,
        suggestEnvVars: true,
        suggestAliases: false,
        placeholder: '$ANTHROPIC_API_KEY or sk-ant-…',
        errors: settings.getErrors('anthropicApiKey'),
    }) }}
    
    {% if settings.anthropicApiKey %}
        <div class="accessibility-audit-verify-row">
            <button type="button" id="accessibility-audit-verify-key-btn" class="btn small">
                {{ 'Verify API Key'|t('accessibility-audit') }}
            </button>
            <span id="accessibility-audit-verify-key-result" class="accessibility-audit-inline-result" role="status" aria-live="polite"></span>
        </div>
    {% endif %}
    
    {{ forms.selectField({
        label: 'Language'|t('accessibility-audit'),
        instructions: 'Language for generated alt text. Claude will respond in the selected language.'|t('accessibility-audit'),
        id: 'altTextLanguage',
        name: 'settings[altTextLanguage]',
        warning: config.altTextLanguage is defined ? 'Overridden by config file.'|t('accessibility-audit'),
        disabled: config.altTextLanguage is defined,
        options: [
            { value: 'English',    label: 'English' },
            { value: 'Spanish',    label: 'Spanish' },
            { value: 'French',     label: 'French' },
            { value: 'German',     label: 'German' },
            { value: 'Portuguese', label: 'Portuguese' },
            { value: 'Italian',    label: 'Italian' },
            { value: 'Dutch',      label: 'Dutch' },
            { value: 'Japanese',   label: 'Japanese' },
            { value: 'Chinese',    label: 'Chinese (Simplified)' },
            { value: 'Korean',     label: 'Korean' },
            { value: 'Arabic',     label: 'Arabic' },
            { value: 'Swedish',    label: 'Swedish' },
            { value: 'Norwegian',  label: 'Norwegian' },
            { value: 'Danish',     label: 'Danish' },
            { value: 'Finnish',    label: 'Finnish' },
        ],
        value: settings.altTextLanguage,
        errors: settings.getErrors('altTextLanguage'),
    }) }}
    
    {{ forms.lightswitchField({
        label: 'Generate for New Assets'|t('accessibility-audit'),
        instructions: 'Draft alt text in the background when new images are uploaded. Existing alt text is never overwritten.'|t('accessibility-audit'),
        id: 'autoGenerateAlt',
        name: 'settings[autoGenerateAlt]',
        warning: config.autoGenerateAlt is defined ? 'Overridden by config file.'|t('accessibility-audit'),
        disabled: config.autoGenerateAlt is defined,
        on: settings.autoGenerateAlt,
        toggle: 'accessibility-audit-new-asset-alt-mode',
        errors: settings.getErrors('autoGenerateAlt'),
    }) }}

    <div id="accessibility-audit-new-asset-alt-mode"{% if not settings.autoGenerateAlt and not settings.hasErrors('newAssetAltMode') %} class="hidden"{% endif %}>
    {{ forms.selectField({
        label: 'New uploads'|t('accessibility-audit'),
        instructions: 'Where the drafts go. Drafts Claude flags for checking always go to Drafts to review on the Assets page. Alt text saved straight to the image is not seen by anyone before it goes live, and text inside an image can sometimes steer the AI.'|t('accessibility-audit'),
        id: 'newAssetAltMode',
        name: 'settings[newAssetAltMode]',
        warning: config.newAssetAltMode is defined ? 'Overridden by config file.'|t('accessibility-audit'),
        disabled: config.newAssetAltMode is defined,
        options: [
            { value: 'review', label: 'Save drafts for review'|t('accessibility-audit') },
            { value: 'save', label: 'Save to the image when there is nothing to check'|t('accessibility-audit') },
        ],
        value: settings.newAssetAltMode,
        errors: settings.getErrors('newAssetAltMode'),
    }) }}
    </div>
    
    {{ forms.textareaField({
        label: 'Site Context (optional)'|t('accessibility-audit'),
        instructions: 'A short description of your site or brand. Sent with each generation request to improve accuracy. E.g. "E-commerce store selling premium fountain pens and stationery."'|t('accessibility-audit'),
        id: 'altTextContext',
        name: 'settings[altTextContext]',
        warning: config.altTextContext is defined ? 'Overridden by config file.'|t('accessibility-audit'),
        disabled: config.altTextContext is defined,
        value: settings.altTextContext,
        rows: 2,
        errors: settings.getErrors('altTextContext'),
    }) }}
    {% else %}
        {% include 'accessibility-audit/_includes/pro-upsell' with {
            feature: 'AI alt text'|t('accessibility-audit'),
            text: 'Draft alt text for your images with Claude, one at a time or the whole missing-alt list in one go, with every draft kept for review. Available on the Plus edition.'|t('accessibility-audit'),
            edition: 'plus',
            headingLevel: 4,
        } only %}
    {% endif %}

    <hr>

    <h2>{{ 'CI/CD Integration'|t('accessibility-audit') }}</h2>

    {% if not (isPro ?? false) %}
        {% include 'accessibility-audit/_includes/pro-upsell' with {
            feature: 'CI/CD Integration'|t('accessibility-audit'),
            text: 'Give your build pipeline a token to poll the site\'s accessibility score and gate deploys on a target. Available on the Pro edition.'|t('accessibility-audit'),
            edition: 'pro',
            headingLevel: 4,
        } only %}
    {% else %}
    <p class="light">
        {{ 'Give your build pipeline a token to poll the site\'s current accessibility score. Point it at {url} with the token in an {header} header (or a {param} query parameter). The response reports whether the score meets the target set under General settings.'|t('accessibility-audit', {
            url: '<code>' ~ actionUrl('accessibility-audit/ci/check') ~ '</code>',
            header: '<code>Authorization: Bearer</code>',
            param: '<code>ciToken</code>',
        })|raw }}
    </p>

    {% if newCiApiToken is defined and newCiApiToken %}

        {{ forms.copytextField({
            label: 'New token'|t('accessibility-audit'),
            instructions: 'Copy this now, it won\'t be shown in full again.'|t('accessibility-audit'),
            id: 'new-ci-api-token',
            value: newCiApiToken,
        }) }}
    {% endif %}

    {% set tokenValue = settings.ciApiToken
        ? 'A token is set. It is stored hashed, so it can only be shown in full once, at generation.'|t('accessibility-audit')
        : 'No token generated yet.'|t('accessibility-audit') %}

    {{ forms.field({
        label: 'Current token'|t('accessibility-audit'),
    }, '<span class="light">' ~ tokenValue|e ~ '</span>') }}

    {% if not readOnly %}
        <div class="field">
            <button type="submit"
                    class="btn"
                    formaction="{{ actionUrl('accessibility-audit/settings/generate-ci-token') }}"
                    {% if settings.ciApiToken %}data-aa-confirm="{{ 'Regenerate the CI token? Anything still using the current one will be refused until it is given the new one.'|t('accessibility-audit') }}"{% endif %}>
                {{ settings.ciApiToken
                    ? 'Regenerate token'|t('accessibility-audit')
                    : 'Generate token'|t('accessibility-audit') }}
            </button>
        </div>
    {% endif %}
    {% endif %}

    <hr>

    <h2>{{ 'Decoupled Frontends'|t('accessibility-audit') }}</h2>

    {% if not (isPro ?? false) %}
        {% include 'accessibility-audit/_includes/pro-upsell' with {
            feature: 'Decoupled Frontends'|t('accessibility-audit'),
            text: 'Run the admin overlay on a headless frontend (Next, Nuxt, Astro) with a single script tag. Available on the Pro edition.'|t('accessibility-audit'),
            edition: 'pro',
            headingLevel: 4,
        } only %}
    {% else %}
    <p class="light">
        {{ 'If your site\'s frontend is not served by Craft, add {tag} to its pages and the overlay runs there too: same axe engine, same rules, results stored against the same scans. Head or footer makes no difference as long as {defer} stays on the tag. The script does nothing for regular visitors. In Craft templates (a hybrid install), use {variable} instead: it resolves this install\'s URL itself and renders nothing when the feature is off.'|t('accessibility-audit', {
            tag: '<code>&lt;script src="' ~ (overlayScriptUrl ?? '/accessibility-audit/overlay.js')|e ~ '" defer&gt;&lt;/script&gt;</code>',
            defer: '<code>defer</code>',
            variable: '<code>{{ craft.a11y.overlayScriptTag() }}</code>',
        })|raw }}
    </p>
    <p class="light">
        {{ 'To activate the overlay in a browser, open the frontend through an activation link: the frontend\'s own URL with {fragment} appended, using the token below. It must be the frontend\'s domain, not this install\'s, because the browser stores the token per domain. A small notice in the corner confirms the activation took. The overlay endpoints only answer requests carrying that token.'|t('accessibility-audit', {
            fragment: '<code>#a11y-connect=&lt;token&gt;</code>',
        })|raw }}
    </p>

    {{ forms.lightswitchField({
        label: 'Enable Decoupled Overlay'|t('accessibility-audit'),
        instructions: 'Serve the overlay loader and answer its token-authenticated API calls.'|t('accessibility-audit')
            ~ ' <span class="info">' ~ 'This is independent of the Frontend Overlay switch under General, which only controls injection on pages Craft renders itself. Turn this on when the front end is served by something else and needs to load the overlay for itself.'|t('accessibility-audit') ~ '</span>',
        id: 'decoupledOverlay',
        name: 'settings[decoupledOverlay]',
        on: settings.decoupledOverlay,
        errors: settings.getErrors('decoupledOverlay'),
        warning: config.decoupledOverlay is defined ? 'Overridden by config file.'|t('accessibility-audit'),
        disabled: config.decoupledOverlay is defined,
    }) }}

    {{ forms.textareaField({
        label: 'Additional Allowed Origins'|t('accessibility-audit'),
        instructions: 'Origins allowed to call the overlay endpoints, one per line, e.g. {example}. Every site\'s base URL origin is always allowed; add entries here for dev servers and preview deployments Craft doesn\'t know about.'|t('accessibility-audit', {
            example: '`http://localhost:3000`',
        }),
        id: 'overlayAllowedOrigins',
        name: 'settings[overlayAllowedOrigins]',
        value: settings.overlayAllowedOrigins,
        rows: 3,
        errors: settings.getErrors('overlayAllowedOrigins'),
        warning: config.overlayAllowedOrigins is defined ? 'Overridden by config file.'|t('accessibility-audit'),
        disabled: config.overlayAllowedOrigins is defined,
    }) }}

    {% if newOverlayApiToken is defined and newOverlayApiToken %}

        {{ forms.copytextField({
            label: 'New overlay token'|t('accessibility-audit'),
            instructions: 'Copy this now, it won\'t be shown in full again.'|t('accessibility-audit'),
            id: 'new-overlay-api-token',
            value: newOverlayApiToken,
        }) }}
    {% endif %}

    {% set overlayTokenValue = settings.overlayApiToken
        ? 'A token is set. It is stored hashed, so it can only be shown in full once, at generation.'|t('accessibility-audit')
        : 'No token generated yet.'|t('accessibility-audit') %}

    {{ forms.field({
        label: 'Current overlay token'|t('accessibility-audit'),
    }, '<span class="light">' ~ overlayTokenValue|e ~ '</span>') }}

    {% if not readOnly %}
        <div class="field">
            <button type="submit"
                    class="btn"
                    formaction="{{ actionUrl('accessibility-audit/settings/generate-overlay-token') }}"
                    {% if settings.overlayApiToken %}data-aa-confirm="{{ 'Regenerate the overlay token? Browsers activated with the current one stop showing the overlay until they are activated again.'|t('accessibility-audit') }}"{% endif %}>
                {{ settings.overlayApiToken
                    ? 'Regenerate token'|t('accessibility-audit')
                    : 'Generate token'|t('accessibility-audit') }}
            </button>
        </div>
    {% endif %}
    {% endif %}
{% if readOnly %}</fieldset>{% endif %}
{% js %}
document.querySelectorAll('[data-aa-confirm]').forEach(function(button) {
    button.addEventListener('click', function(event) {
        if (!window.confirm(button.dataset.aaConfirm)) {
            event.preventDefault();
        }
    });
});
{% endjs %}
{% endblock %}
