<!DOCTYPE html>
<html lang="{{ language }}">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
{% set heading = report.name() %}
<title>{{ heading }}: {{ organisationName is not empty ? organisationName : siteName }}</title>
<style>
*, *::before, *::after { box-sizing: border-box; }
body {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;
    font-size: 14px;
    line-height: 1.5;
    color: #1f2933;
    background: #fff;
    margin: 0;
}
a { color: #0b5cad; }
.visually-hidden {
    position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0;
    overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;
}
main { max-width: 900px; margin: 0 auto; padding: 32px 24px 48px; }
h1 { font-size: 26px; margin: 0 0 4px; }
h2 { font-size: 17px; margin: 28px 0 8px; }
p { margin: 0 0 10px; }
.report-meta { color: #52606d; margin-bottom: 24px; }
.report-figures { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 12px; margin: 16px 0; padding: 0; list-style: none; }
.report-figures li { border: 1px solid #cbd2d9; border-radius: 6px; padding: 12px 14px; }
.report-figure__value { display: block; font-size: 24px; font-weight: 700; }
.report-figure__label { display: block; color: #52606d; font-size: 13px; }
table { width: 100%; border-collapse: collapse; margin: 8px 0 16px; }
th, td { text-align: left; padding: 6px 8px; border-bottom: 1px solid #e4e7eb; vertical-align: top; }
thead th { border-bottom: 2px solid #9aa5b1; font-size: 13px; }
td.num, th.num { text-align: right; font-variant-numeric: tabular-nums; }
.report-note { white-space: pre-line; border-left: 3px solid #9aa5b1; padding: 4px 0 4px 12px; }
.report-notice { background: #fff8e1; border: 1px solid #e0c36a; border-radius: 6px; padding: 8px 12px; }
.report-chart { display: block; width: 100%; height: auto; max-height: 160px; margin: 8px 0; }
.report-footer { margin-top: 32px; padding-top: 12px; border-top: 1px solid #cbd2d9; color: #52606d; font-size: 13px; }
.report-print-bar {
    position: sticky; top: 0; display: flex; justify-content: space-between; align-items: center;
    gap: 12px; padding: 10px 24px; background: #1f2933; color: #fff; font-size: 13px;
}
.report-print-bar button {
    font: inherit; padding: 6px 14px; border-radius: 4px; border: 1px solid #fff; cursor: pointer;
    background: #fff; color: #1f2933;
}
.report-print-bar button:focus-visible { outline: 3px solid #7eb8f7; outline-offset: 2px; }
@page { margin: 16mm 14mm; }
@media print {
    body { font-size: 12px; }
    main { padding: 0; max-width: none; }
    .report-print-bar { display: none !important; }
    thead { display: table-header-group; }
    tr, .report-figures li { break-inside: avoid; page-break-inside: avoid; }
    h1, h2 { break-after: avoid; page-break-after: avoid; }
    a { color: inherit; text-decoration: none; }
}
</style>
</head>
<body>
<div id="report-print-bar-mount"></div>
<main>
    <h1>{{ heading }}</h1>
    <p class="report-meta">
        {{ organisationName is not empty ? organisationName ~ ', ' : '' }}{{ siteName }}.
        {{ 'Made on {date}.'|t('accessibility-audit', { date: generated }) }}
        {% block filterLine %}{% endblock %}
    </p>

    {% block body %}{% endblock %}

    <footer class="report-footer">
        <p>
            {% if freshness.scanned > 0 %}
                {{ 'Based on the latest scan of {scanned} of {scannable} pages.'|t('accessibility-audit', { scanned: freshness.scanned|number, scannable: max(freshness.scanned, freshness.scannable)|number }) }}
                {% if freshness.oldestDays is not null %}
                    {{ 'Scans range from {newest} to {oldest} days old.'|t('accessibility-audit', { newest: freshness.newestDays, oldest: freshness.oldestDays }) }}
                {% endif %}
            {% else %}
                {{ 'No pages have been scanned yet.'|t('accessibility-audit') }}
            {% endif %}
        </p>
        {% if freshness.sweeping %}
            <p>{{ 'A full scan was running when this was made, so some pages are showing older results.'|t('accessibility-audit') }}</p>
        {% endif %}
        <p>{{ 'Automated checks find a share of accessibility problems, not all of them. Testing by people, with a keyboard and a screen reader, covers the rest.'|t('accessibility-audit') }}</p>
    </footer>
</main>
{% set jsonFlags = constant('JSON_HEX_TAG') b-or constant('JSON_HEX_APOS') b-or constant('JSON_HEX_QUOT') b-or constant('JSON_HEX_AMP') %}
<script>
(function() {
    'use strict';

    var mount = document.getElementById('report-print-bar-mount');
    if (!mount) { return; }

    var bar = document.createElement('div');
    bar.className = 'report-print-bar';

    var label = document.createElement('span');
    label.textContent = {{ heading|json_encode(jsonFlags)|raw }};

    var print = document.createElement('button');
    print.type = 'button';
    print.textContent = {{ 'Print / Save as PDF'|t('accessibility-audit')|json_encode(jsonFlags)|raw }};
    print.addEventListener('click', function() { window.print(); });

    bar.appendChild(label);
    bar.appendChild(print);
    mount.parentNode.replaceChild(bar, mount);
})();
</script>
</body>
</html>
