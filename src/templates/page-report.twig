{% extends '_layouts/cp' %}


{% set title = pageLabel %}
{% set selectedSubnavItem = 'issues' %}
{% set crumbs = [
    { label: 'Accessibility Audit'|t('accessibility-audit'), url: cpUrl('accessibility-audit') },
    { label: 'Pages with issues'|t('accessibility-audit'), url: cpUrl('accessibility-audit/issues', {site: siteHandle, tab: 'pages'}) },
    { label: title },
] %}


{% import 'accessibility-audit/_macros' as macros %}

{% set pageUrl = element and element.url ? element.url : null %}

{% set previewUrl = pageUrl ? (pageUrl ~ ('?' in pageUrl ? '&' : '?') ~ 'accessibility-audit-preview=1') : null %}


{% if sites|length > 1 %}
    {% set crumbs = [{
        id: 'site-crumb',
        icon: 'world',
        label: requestedSite.name|t('site'),
        menu: { items: siteMenuItems(sites, requestedSite), label: 'Select site'|t('app') },
    }]|merge(crumbs ?? []) %}
{% endif %}

{% block actionButton %}
<div class="flex gap-s">
    {% if element %}
        <a href="{{ element.cpEditUrl }}" class="btn">{{ 'Edit element'|t('accessibility-audit') }}</a>
        {% if pageUrl %}
            <a href="{{ pageUrl }}" target="_blank" rel="noopener" class="btn">
                <span class="cp-icon small" aria-hidden="true">{{ iconSvg('arrow-up-right-from-square') }}</span>
                {{ 'View page'|t('accessibility-audit') }}
                <span class="visually-hidden">({{ 'opens in new tab'|t('accessibility-audit') }})</span>
            </a>
        {% endif %}
        <button class="btn submit" data-icon="refresh" data-accessibility-audit-scan-entry="{{ elementId }}" data-site-id="{{ siteId }}" aria-live="polite">
            {{ 'Re-scan'|t('accessibility-audit') }}
        </button>
    {% endif %}
</div>
{% endblock %}

{% block content %}
{% set severityLabels = {
    error: 'Error'|t('accessibility-audit'),
    warning: 'Warning'|t('accessibility-audit'),
    notice: 'Notice'|t('accessibility-audit'),
} %}
<div class="accessibility-audit-page-report-wrap">

<script id="accessibility-audit-filter-defs-src" type="text/plain">
<svg id="accessibility-audit-cf-defs" style="display:none;position:absolute" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <filter id="accessibility-audit-protanopia" color-interpolation-filters="linearRGB">
      <feColorMatrix type="matrix" values="
        0.152  1.053 -0.205  0  0
        0.115  0.786  0.099  0  0
       -0.004 -0.048  1.052  0  0
        0      0      0      1  0"/>
    </filter>
    <filter id="accessibility-audit-deuteranopia" color-interpolation-filters="linearRGB">
      <feColorMatrix type="matrix" values="
        0.367  0.861 -0.228  0  0
        0.280  0.673  0.047  0  0
       -0.012  0.043  0.969  0  0
        0      0      0      1  0"/>
    </filter>
    <filter id="accessibility-audit-tritanopia" color-interpolation-filters="linearRGB">
      <feColorMatrix type="matrix" values="
        1.256 -0.077 -0.178  0  0
       -0.078  0.931  0.148  0  0
        0.005  0.691  0.304  0  0
        0      0      0      1  0"/>
    </filter>
    <filter id="accessibility-audit-achromatopsia">
      <feColorMatrix type="matrix" values="
        0.299  0.587  0.114  0  0
        0.299  0.587  0.114  0  0
        0.299  0.587  0.114  0  0
        0      0      0      1  0"/>
    </filter>
  </defs>
</svg>
</script>

{% if pageUrl %}
<p class="accessibility-audit-callout accessibility-audit-callout--notice accessibility-audit-pr-mobile-note">
    {{ 'The issues list works fine at this size, but the live preview and highlighting need more room. For the full report, use a wider screen.'|t('accessibility-audit') }}
</p>
<div class="accessibility-audit-pr-layout">

    <div class="accessibility-audit-pr-sidebar">

        {% if scan %}
        {% set scoreClass = macros.scoreClass(scan.score) %}
        {% set scoreNumClass = {good: 'pass', fair: 'warn', poor: 'error'}[scoreClass] %}
        <div class="accessibility-audit-pr-score-row">
            <span class="accessibility-audit-num--{{ scoreNumClass }} accessibility-audit-pr-score-num">{{ scan.score }}</span>
            <span class="light accessibility-audit-note">/100</span>
            <div class="accessibility-audit-pr-score-counts accessibility-audit-panel__legend">
                {% for severity, count in {
                    error: scan.errorCount,
                    warning: scan.warningCount,
                    notice: scan.noticeCount,
                } %}
                    <span class="accessibility-audit-panel__leg">
                        <span class="accessibility-audit-panel__dot accessibility-audit-panel__dot--{{ severity }}"></span>
                        {{ count }}
                        <span class="visually-hidden">{{ severityLabels[severity] ?? severity }}</span>
                    </span>
                {% endfor %}
            </div>
        </div>
        {% endif %}

        <div class="accessibility-audit-pr-section">
            <button class="accessibility-audit-pr-acc-header accessibility-audit-pr-acc-header--issues accessibility-audit-pr-acc-open"
                    aria-expanded="true" aria-controls="accessibility-audit-pr-acc-issues" data-accessibility-audit-pr-accordion>
                <span class="accessibility-audit-pr-acc-label">
                    {{ 'Issues'|t('accessibility-audit') }}
                    <span class="accessibility-audit-pr-acc-badge">{{ issues|length }}</span>
                </span>
                <span class="accessibility-audit-expand-icon" data-icon="downangle" aria-hidden="true"></span>
            </button>
            <div class="accessibility-audit-pr-acc-body" id="accessibility-audit-pr-acc-issues">
                {% if issues|length == 0 %}
                    <p class="accessibility-audit-pr-empty">✓ {{ 'No issues found'|t('accessibility-audit') }}</p>
                {% else %}
                    {% for issue in issues %}
                    {% set issueJson = {
                        ruleId:       issue.ruleId,
                        severity:     issue.severity,
                        wcagLevel:    issue.wcagLevel ?? null,
                        wcagCriterion:issue.wcagCriterion ?? null,
                        occurrences:  issue.occurrences,
                        message:      issue.message ?? null,
                        helpUrl:      issue.helpUrl ?? null,
                        context:      issue.context ?? null
                    }|json_encode %}
                    <div class="accessibility-audit-pr-issue-item">
                        {% set prExpandId = 'accessibility-audit-pr-expand-' ~ loop.index %}
                        <div class="accessibility-audit-pr-issue-line">
                            <div class="accessibility-audit-pr-issue-row"
                                 role="button" tabindex="0" aria-expanded="false"
                                 aria-controls="{{ prExpandId }}"
                                 data-rule-id="{{ issue.ruleId|e('html_attr') }}"
                                 data-scan-id="{{ scan.id ?? 0 }}"
                                 data-severity="{{ issue.severity|e('html_attr') }}"
                                 data-issue="{{ issueJson|e('html_attr') }}"
                                 title="{{ 'Click to highlight and inspect'|t('accessibility-audit') }}">
                                <span class="accessibility-audit-pr-dot accessibility-audit-pr-dot--{{ issue.severity }}"></span>
                                <span class="visually-hidden">{{ severityLabels[issue.severity] ?? issue.severity }}:</span>
                                <span class="accessibility-audit-pr-issue-name">{{ issue.ruleId }}</span>
                                <span class="accessibility-audit-pr-issue-count">{{ issue.occurrences }}</span>
                            </div>
                            <a href="{{ url('accessibility-audit/issues/detail', {ruleId: issue.ruleId, site: siteHandle}) }}"
                               class="accessibility-audit-pr-detail-arrow"
                               title="{{ 'View issue details'|t('accessibility-audit') }}"
                               aria-label="{{ 'View details for '|t('accessibility-audit') }}{{ issue.ruleId }}">→</a>
                        </div>
                        <div class="accessibility-audit-pr-issue-expand" id="{{ prExpandId }}" hidden>
                            <div class="accessibility-audit-pr-issue-expand-body"></div>
                        </div>
                    </div>
                    {% endfor %}
                {% endif %}
            </div>
        </div>

        <div class="accessibility-audit-pr-section">
            <button class="accessibility-audit-pr-acc-header"
                    aria-expanded="{{ potentialCount ? 'true' : 'false' }}" aria-controls="accessibility-audit-pr-acc-potential" data-accessibility-audit-pr-accordion>
                <span class="accessibility-audit-pr-acc-label">
                    {{ 'Needs review'|t('accessibility-audit') }}
                    <span class="accessibility-audit-pr-acc-badge">{{ potentialCount }}</span>
                </span>
                <span class="accessibility-audit-expand-icon" data-icon="downangle" aria-hidden="true"></span>
            </button>
            <div class="accessibility-audit-pr-acc-body accessibility-audit-pr-acc-body--padded" id="accessibility-audit-pr-acc-potential"{{ potentialCount ? '' : ' hidden' }}>
                {% if potentialCount == 0 and dismissed|length == 0 %}
                    <p class="accessibility-audit-pr-empty">{{ 'Nothing to review'|t('accessibility-audit') }}</p>
                {% else %}
                    {% if potentialCount %}
                        <p class="accessibility-audit-pr-review-intro light">{{ 'These need a human eye. They do not count against your score until you confirm one.'|t('accessibility-audit') }}</p>
                        {% if canRunScans and potentialCount > 1 %}
                            <div class="accessibility-audit-pr-bulk" id="accessibility-audit-pr-bulk-bar">
                                <label class="accessibility-audit-pr-bulk__all">
                                    <input type="checkbox" id="accessibility-audit-pr-bulk-all" class="checkbox">
                                    <span>{{ 'Select all'|t('accessibility-audit') }}</span>
                                </label>
                                <button type="button" class="btn small" id="accessibility-audit-pr-bulk-dismiss" disabled>
                                    {{ 'Dismiss selected'|t('accessibility-audit') }}
                                </button>
                                <span class="accessibility-audit-pr-review__status" id="accessibility-audit-pr-bulk-status" role="status" aria-live="polite"></span>
                            </div>
                        {% endif %}
                    {% endif %}

                    {% for group in potential %}
                        <div class="accessibility-audit-pr-review-group">
                            <p class="accessibility-audit-pr-review__q">
                                {{ group.question }}
                                {% if group.occurrences|length > 1 %}
                                    <span class="accessibility-audit-pr-acc-badge">{{ group.occurrences|length }}</span>
                                {% endif %}
                            </p>

                            {% for row in group.occurrences %}
                                <div class="accessibility-audit-pr-review" data-accessibility-audit-review
                                     data-rule-id="{{ row.ruleId }}"
                                     data-context="{{ row.context|default('') }}">
                                    {% if canRunScans and potentialCount > 1 %}
                                        <label class="accessibility-audit-pr-review__pick">
                                            <input type="checkbox" class="checkbox" data-bulk-pick
                                                   aria-label="{{ 'Select for bulk dismissal'|t('accessibility-audit') }}">
                                        </label>
                                    {% endif %}
                                    {% if row.context %}
                                        <p class="accessibility-audit-pr-review__ctx" title="{{ row.context }}">{{ row.context }}</p>
                                    {% elseif row.message %}
                                        <p class="accessibility-audit-pr-review__msg light">{{ row.message }}</p>
                                    {% endif %}
                                    <div class="accessibility-audit-pr-review__actions">
                                        <button type="button" class="btn small" data-highlight>{{ 'Show on page'|t('accessibility-audit') }}</button>
                                        {% if canRunScans %}
                                            <button type="button" class="btn small" data-verdict="dismissed">{{ 'Not an issue'|t('accessibility-audit') }}</button>
                                            <button type="button" class="btn small accessibility-audit-pr-review__confirm" data-verdict="confirmed">{{ 'Confirm as failure'|t('accessibility-audit') }}</button>
                                            <span class="accessibility-audit-pr-review__status" role="status" aria-live="polite"></span>
                                        {% endif %}
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    {% endfor %}

                    {% if dismissed|length %}
                        <div class="accessibility-audit-pr-dismissed">
                            <button type="button" class="accessibility-audit-pr-dismissed__toggle"
                                    aria-expanded="false" aria-controls="accessibility-audit-pr-dismissed-body"
                                    data-accessibility-audit-pr-accordion>
                                {{ 'Dismissed'|t('accessibility-audit') }}
                                <span class="accessibility-audit-pr-acc-badge">{{ dismissed|length }}</span>
                            </button>
                            <div id="accessibility-audit-pr-dismissed-body" hidden>
                                {% for row in dismissed %}
                                    <div class="accessibility-audit-pr-review accessibility-audit-pr-review--dismissed"
                                         data-accessibility-audit-review
                                         data-rule-id="{{ row.ruleId }}"
                                         data-context="{{ row.context|default('') }}">
                                        <p class="accessibility-audit-pr-review__ctx" title="{{ row.context|default('') }}">{{ row.context|default(row.question) }}</p>
                                        {% if canRunScans %}
                                            <div class="accessibility-audit-pr-review__actions">
                                                <button type="button" class="btn small" data-verdict="">{{ 'Restore'|t('accessibility-audit') }}</button>
                                                <span class="accessibility-audit-pr-review__status" role="status" aria-live="polite"></span>
                                            </div>
                                        {% endif %}
                                    </div>
                                {% endfor %}
                            </div>
                        </div>
                    {% endif %}
                {% endif %}
            </div>
        </div>

        <div class="accessibility-audit-pr-section">
            <button class="accessibility-audit-pr-acc-header accessibility-audit-pr-acc-header--resolved"
                    aria-expanded="false" aria-controls="accessibility-audit-pr-acc-resolved" data-accessibility-audit-pr-accordion>
                <span class="accessibility-audit-pr-acc-label">
                    {{ 'Resolved issues'|t('accessibility-audit') }}
                    <span class="accessibility-audit-pr-acc-badge">{{ resolved|length }}</span>
                </span>
                <span class="accessibility-audit-expand-icon" data-icon="downangle" aria-hidden="true"></span>
            </button>
            <div class="accessibility-audit-pr-acc-body" id="accessibility-audit-pr-acc-resolved" hidden>
                {% if resolved|length == 0 %}
                    <p class="accessibility-audit-pr-empty">{{ 'None yet'|t('accessibility-audit') }}</p>
                {% else %}
                    {% for row in resolved %}
                    <a href="{{ url('accessibility-audit/issues/detail', {ruleId: row.ruleId, site: siteHandle}) }}"
                       class="accessibility-audit-pr-issue-row accessibility-audit-pr-issue-row--resolved">
                        <span class="accessibility-audit-pr-dot accessibility-audit-pr-dot--resolved">✓</span>
                        <span class="accessibility-audit-pr-issue-name">{{ row.ruleId }}</span>
                        <span class="accessibility-audit-pr-issue-count">{{ row.count }}</span>
                    </a>
                    {% endfor %}
                {% endif %}
            </div>
        </div>


    </div>

    <div class="accessibility-audit-pr-resize-handle" id="accessibility-audit-pr-resize-handle"
         role="separator" tabindex="0" aria-orientation="vertical"
         aria-label="{{ 'Resize issues sidebar'|t('accessibility-audit') }}"
         aria-valuemin="200" aria-valuemax="560" aria-valuenow="280"></div>

    <div class="accessibility-audit-pr-preview">

        <div class="accessibility-audit-pr-toolbar">
            <div class="accessibility-audit-pr-tabs btngroup" role="tablist" aria-label="{{ 'Preview mode'|t('accessibility-audit') }}">
                <button class="accessibility-audit-pr-tab accessibility-audit-pr-tab--active btn" data-pr-view="content"
                        role="tab" id="accessibility-audit-tab-content" aria-selected="true" aria-controls="accessibility-audit-pane-content">
                    {{ 'View page content'|t('accessibility-audit') }}
                </button>
                <button class="accessibility-audit-pr-tab btn" data-pr-view="html"
                        role="tab" id="accessibility-audit-tab-html" aria-selected="false" aria-controls="accessibility-audit-pane-html" tabindex="-1">
                    {{ 'View HTML'|t('accessibility-audit') }}
                </button>
            </div>
            <div class="accessibility-audit-pr-tabs btngroup" role="group" aria-label="{{ 'Preview viewport'|t('accessibility-audit') }}">
                <button class="accessibility-audit-pr-tab accessibility-audit-pr-tab--active btn" data-pr-viewport="desktop" aria-pressed="true">
                    {{ 'Desktop'|t('accessibility-audit') }}
                </button>
                <button class="accessibility-audit-pr-tab btn" data-pr-viewport="mobile" aria-pressed="false">
                    {{ 'Mobile'|t('accessibility-audit') }}
                </button>
            </div>
            <button class="accessibility-audit-pr-explorer-btn btn" id="accessibility-audit-explorer-trigger" aria-expanded="false" aria-controls="accessibility-audit-explorer-panel">
                <span data-icon="view" aria-hidden="true"></span>
                {{ 'Accessibility Explorer'|t('accessibility-audit') }}
            </button>
        </div>

        <div class="accessibility-audit-pr-pane" id="accessibility-audit-pane-content" role="tabpanel" aria-labelledby="accessibility-audit-tab-content">
            <div class="accessibility-audit-preview-loading" id="accessibility-audit-preview-loading" aria-hidden="true">
                <span class="accessibility-audit-preview-loading__spinner"></span>
                {{ 'Loading preview…'|t('accessibility-audit') }}
            </div>
            <iframe id="accessibility-audit-preview-iframe"
                    src="{{ previewUrl|e('html_attr') }}"
                    data-page-url="{{ pageUrl|e('html_attr') }}"
                    class="accessibility-audit-preview-iframe"
                    title="{{ 'Page preview'|t('accessibility-audit') }}">
            </iframe>
        </div>

        <div class="accessibility-audit-pr-pane" id="accessibility-audit-pane-html" role="tabpanel" aria-labelledby="accessibility-audit-tab-html" tabindex="0" hidden>
            <pre class="accessibility-audit-html-source" id="accessibility-audit-html-source"><code class="accessibility-audit-html-code"></code></pre>
        </div>

        <div class="accessibility-audit-explorer-panel" id="accessibility-audit-explorer-panel" hidden aria-label="{{ 'Accessibility Explorer'|t('accessibility-audit') }}">
            <div class="accessibility-audit-explorer-hdr">
                <span class="accessibility-audit-explorer-title">
                    <span data-icon="view" aria-hidden="true" style="flex-shrink:0"></span>
                    {{ 'Accessibility Explorer'|t('accessibility-audit') }}
                </span>
                <button class="accessibility-audit-explorer-close" id="accessibility-audit-explorer-close" aria-label="{{ 'Close'|t('app') }}">
                    <span data-icon="remove" aria-hidden="true"></span>
                </button>
            </div>

            <div class="accessibility-audit-explorer-body">

                <div class="accessibility-audit-explorer-section">
                    <p class="accessibility-audit-explorer-section-title">{{ 'Colour vision'|t('accessibility-audit') }}</p>
                    <div class="accessibility-audit-explorer-filters" role="group" aria-label="{{ 'Colour vision filters'|t('accessibility-audit') }}">

                        <button class="accessibility-audit-filter-row accessibility-audit-filter-row--active" data-colour-filter="none" aria-pressed="true">
                            <span class="accessibility-audit-filter-swatch accessibility-audit-filter-swatch--normal" aria-hidden="true"></span>
                            <span class="accessibility-audit-filter-info">
                                <span class="accessibility-audit-filter-name">{{ 'Normal vision'|t('accessibility-audit') }}</span>
                            </span>
                            <span class="accessibility-audit-filter-check" aria-hidden="true">
                                {{ craft.a11y.icon('check') }}
                            </span>
                        </button>

                        <button class="accessibility-audit-filter-row" data-colour-filter="url(#accessibility-audit-achromatopsia)" aria-pressed="false">
                            <span class="accessibility-audit-filter-swatch accessibility-audit-filter-swatch--grayscale" aria-hidden="true"></span>
                            <span class="accessibility-audit-filter-info">
                                <span class="accessibility-audit-filter-name">{{ 'Achromatopsia'|t('accessibility-audit') }}</span>
                                <span class="accessibility-audit-filter-desc">{{ 'Total colour blindness'|t('accessibility-audit') }}</span>
                            </span>
                            <span class="accessibility-audit-filter-check" aria-hidden="true">
                                {{ craft.a11y.icon('check') }}
                            </span>
                        </button>

                        <button class="accessibility-audit-filter-row" data-colour-filter="url(#accessibility-audit-protanopia)" aria-pressed="false">
                            <span class="accessibility-audit-filter-swatch accessibility-audit-filter-swatch--protanopia" aria-hidden="true"></span>
                            <span class="accessibility-audit-filter-info">
                                <span class="accessibility-audit-filter-name">{{ 'Protanopia'|t('accessibility-audit') }}</span>
                                <span class="accessibility-audit-filter-desc">{{ 'Red-blind · ~1% of males'|t('accessibility-audit') }}</span>
                            </span>
                            <span class="accessibility-audit-filter-check" aria-hidden="true">
                                {{ craft.a11y.icon('check') }}
                            </span>
                        </button>

                        <button class="accessibility-audit-filter-row" data-colour-filter="url(#accessibility-audit-deuteranopia)" aria-pressed="false">
                            <span class="accessibility-audit-filter-swatch accessibility-audit-filter-swatch--deuteranopia" aria-hidden="true"></span>
                            <span class="accessibility-audit-filter-info">
                                <span class="accessibility-audit-filter-name">{{ 'Deuteranopia'|t('accessibility-audit') }}</span>
                                <span class="accessibility-audit-filter-desc">{{ 'Green-blind · ~1% of males'|t('accessibility-audit') }}</span>
                            </span>
                            <span class="accessibility-audit-filter-check" aria-hidden="true">
                                {{ craft.a11y.icon('check') }}
                            </span>
                        </button>

                        <button class="accessibility-audit-filter-row" data-colour-filter="url(#accessibility-audit-tritanopia)" aria-pressed="false">
                            <span class="accessibility-audit-filter-swatch accessibility-audit-filter-swatch--tritanopia" aria-hidden="true"></span>
                            <span class="accessibility-audit-filter-info">
                                <span class="accessibility-audit-filter-name">{{ 'Tritanopia'|t('accessibility-audit') }}</span>
                                <span class="accessibility-audit-filter-desc">{{ 'Blue-blind · ~0.01% of people'|t('accessibility-audit') }}</span>
                            </span>
                            <span class="accessibility-audit-filter-check" aria-hidden="true">
                                {{ craft.a11y.icon('check') }}
                            </span>
                        </button>

                    </div>
                </div>

                <div class="accessibility-audit-explorer-section">
                    <p class="accessibility-audit-explorer-section-title">{{ 'Visual impairment'|t('accessibility-audit') }}</p>
                    <div class="accessibility-audit-explorer-filters" role="group" aria-label="{{ 'Visual impairment filters'|t('accessibility-audit') }}">

                        <button class="accessibility-audit-filter-row" data-colour-filter="contrast(35%) brightness(1.3)" aria-pressed="false">
                            <span class="accessibility-audit-filter-swatch accessibility-audit-filter-swatch--low-contrast" aria-hidden="true"></span>
                            <span class="accessibility-audit-filter-info">
                                <span class="accessibility-audit-filter-name">{{ 'Low contrast'|t('accessibility-audit') }}</span>
                                <span class="accessibility-audit-filter-desc">{{ 'Reduced contrast sensitivity'|t('accessibility-audit') }}</span>
                            </span>
                            <span class="accessibility-audit-filter-check" aria-hidden="true">
                                {{ craft.a11y.icon('check') }}
                            </span>
                        </button>

                        <button class="accessibility-audit-filter-row" data-colour-filter="blur(2px)" aria-pressed="false">
                            <span class="accessibility-audit-filter-swatch accessibility-audit-filter-swatch--blur" aria-hidden="true"></span>
                            <span class="accessibility-audit-filter-info">
                                <span class="accessibility-audit-filter-name">{{ 'Blurred vision'|t('accessibility-audit') }}</span>
                                <span class="accessibility-audit-filter-desc">{{ 'Cataracts or severe myopia'|t('accessibility-audit') }}</span>
                            </span>
                            <span class="accessibility-audit-filter-check" aria-hidden="true">
                                {{ craft.a11y.icon('check') }}
                            </span>
                        </button>

                    </div>
                </div>

            </div>
        </div>

    </div>

</div>

{% else %}
<div class="readable mt-s">
    <blockquote class="note">
        <p>{{ 'This element has no public URL, showing issue data only.'|t('accessibility-audit') }}</p>
    </blockquote>
</div>

{% if scan %}
<div class="accessibility-audit-card mt-l">
    <div class="accessibility-audit-card-header">{{ 'Issues'|t('accessibility-audit') }} <span class="accessibility-audit-card-subhead">{{ issues|length }}</span></div>
    {% if issues|length == 0 %}
        <p class="accessibility-audit-clean mt-s">✓ {{ 'No issues found.'|t('accessibility-audit') }}</p>
    {% else %}
    <div class="accessibility-audit-table-scroll">
    <table class="accessibility-audit-table accessibility-audit-rule-table data fullwidth">
        <thead><tr>
            <th scope="col" class="orderable" data-sort-type="text"><button type="button">{{ 'Issue'|t('accessibility-audit') }}</button></th>
            <th scope="col" class="accessibility-audit-num-center orderable" data-sort-type="number"><button type="button">{{ 'Conformance'|t('accessibility-audit') }}</button></th>
            <th scope="col" class="accessibility-audit-num-center orderable" data-sort-type="text"><button type="button">{{ 'Success Criteria'|t('accessibility-audit') }}</button></th>
            <th scope="col" class="orderable" data-sort-type="number"><button type="button">{{ 'Difficulty'|t('accessibility-audit') }}</button></th>
            <th scope="col" class="orderable" data-sort-type="text"><button type="button">{{ 'Responsibility'|t('accessibility-audit') }}</button></th>
            <th scope="col" class="orderable" data-sort-type="text"><button type="button">{{ 'Element Type'|t('accessibility-audit') }}</button></th>
            <th scope="col" class="rightalign orderable ordered desc" data-sort-type="number"><button type="button">{{ 'Count'|t('accessibility-audit') }}</button></th>
        </tr></thead>
        <tbody>
            {% for issue in issues %}
            {% set conformanceRank = {a: 1, aa: 2, aaa: 3}[(issue.wcagLevel ?? '')|lower] ?? 0 %}
            {% set difficultyRank = {beginner: 1, intermediate: 2, advanced: 3}[issue.difficulty ?? ''] ?? 0 %}
            <tr>
                <td data-sort-value="{{ issue.ruleId|e('html_attr') }}">
                    {{ macros.severityDot(issue.severity) }}
                    <a href="{{ url('accessibility-audit/issues/detail', {ruleId: issue.ruleId, site: siteHandle}) }}">{{ issue.ruleId }}</a>
                </td>
                <td class="accessibility-audit-num-center" data-sort-value="{{ conformanceRank }}">{{ macros.conformanceBadge(issue.wcagLevel ?? null) }}</td>
                <td class="light accessibility-audit-num-center" data-sort-value="{{ issue.wcagCriterion ?? '' }}">{{ issue.wcagCriterion ?? '—' }}</td>
                <td data-sort-value="{{ difficultyRank }}">{{ macros.difficulty(issue.difficulty ?? null) }}</td>
                <td data-sort-value="{{ issue.responsibility ?? '' }}">{{ macros.responsibility(issue.responsibility ?? null) }}</td>
                <td class="light" data-sort-value="{{ issue.elementType ?? '' }}">{{ issue.elementType ?? '—' }}</td>
                <td class="rightalign" data-sort-value="{{ issue.occurrences }}"><strong>{{ issue.occurrences }}</strong></td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
    </div>
    {{ macros.conformanceLegend() }}
    {% endif %}
</div>
{% endif %}
{% endif %}

</div>



{% endblock %}
